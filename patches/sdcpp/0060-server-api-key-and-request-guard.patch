@@ -0,0 +1,379 @@
+// PS5SD: CORS, the request size limit and the API key (auth.h).
+#include "auth.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <fstream>
+#include <map>
+#include <mutex>
+#include <string>
+
+#include <json.hpp>
+#include "common/log.h"
+
+namespace {
+
+using clock_type = std::chrono::steady_clock;
+
+// A request body larger than this is refused before it is read (sd-server
+// reads bodies into memory). Uploads (PUT /ps5sd/v1/app/uploads/...) are
+// streamed and have no limit; the open routes get a small one.
+constexpr uint64_t k_max_body      = 64ull << 20;
+constexpr uint64_t k_max_open_body = 4096;
+
+constexpr int k_free_failures = 5;    // wrong keys in a row before the lockout
+constexpr int k_max_lock_s    = 60;   // the lockout doubles up to this
+constexpr size_t k_max_clients = 512;  // clients with wrong keys remembered
+constexpr int k_forget_s      = 900;  // a client without a wrong key for this long is forgotten
+
+const char* const k_cookie = "ps5sd_key";
+
+std::mutex g_key_mutex;
+std::string g_key;
+
+struct Failures {
+    int count = 0;
+    clock_type::time_point last;
+    clock_type::time_point locked_until;
+};
+std::mutex g_fail_mutex;
+std::map<std::string, Failures> g_failures;
+
+std::string current_key() {
+    std::lock_guard<std::mutex> lock(g_key_mutex);
+    return g_key;
+}
+
+// Same length and same bytes; the time does not depend on where they differ.
+bool same_key(const std::string& a, const std::string& b) {
+    if (a.size() != b.size() || a.empty()) {
+        return false;
+    }
+    unsigned char diff = 0;
+    for (size_t i = 0; i < a.size(); i++) {
+        diff |= static_cast<unsigned char>(a[i] ^ b[i]);
+    }
+    return diff == 0;
+}
+
+bool starts_with(const std::string& s, const char* prefix) {
+    return s.rfind(prefix, 0) == 0;
+}
+
+std::string trim(const std::string& s) {
+    size_t b = 0, e = s.size();
+    while (b < e && (s[b] == ' ' || s[b] == '\t')) {
+        b++;
+    }
+    while (e > b && (s[e - 1] == ' ' || s[e - 1] == '\t' || s[e - 1] == '\r' || s[e - 1] == '\n')) {
+        e--;
+    }
+    return s.substr(b, e - b);
+}
+
+std::string base64_decode(const std::string& in) {
+    static const std::string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    std::string out;
+    int val = 0, bits = -8;
+    for (char c : in) {
+        if (c == '=') {
+            break;
+        }
+        const size_t p = chars.find(c);
+        if (p == std::string::npos) {
+            continue;
+        }
+        val = (val << 6) + static_cast<int>(p);
+        bits += 6;
+        if (bits >= 0) {
+            out.push_back(static_cast<char>((val >> bits) & 0xff));
+            bits -= 8;
+        }
+    }
+    return out;
+}
+
+std::string cookie_value(const httplib::Request& req, const std::string& name) {
+    const std::string header = req.get_header_value("Cookie");
+    size_t pos               = 0;
+    while (pos < header.size()) {
+        size_t end = header.find(';', pos);
+        if (end == std::string::npos) {
+            end = header.size();
+        }
+        const std::string part = trim(header.substr(pos, end - pos));
+        const size_t eq        = part.find('=');
+        if (eq != std::string::npos && part.substr(0, eq) == name) {
+            return part.substr(eq + 1);
+        }
+        pos = end + 1;
+    }
+    return {};
+}
+
+// The key a request carries, and whether it came only as the cookie.
+struct Presented {
+    std::string key;
+    bool any        = false;
+    bool via_cookie = false;
+};
+
+Presented presented_key(const httplib::Request& req) {
+    Presented p;
+    const std::string auth = trim(req.get_header_value("Authorization"));
+    if (starts_with(auth, "Bearer ") || starts_with(auth, "bearer ")) {
+        p.key = trim(auth.substr(7));
+        p.any = true;
+    } else if (starts_with(auth, "Basic ") || starts_with(auth, "basic ")) {
+        const std::string pair = base64_decode(trim(auth.substr(6)));
+        const size_t colon     = pair.find(':');
+        p.key                  = colon == std::string::npos ? pair : pair.substr(colon + 1);
+        p.any                  = true;
+    } else if (req.has_header("X-API-Key")) {
+        p.key = trim(req.get_header_value("X-API-Key"));
+        p.any = true;
+    } else if (req.has_header("Cookie") && req.get_header_value("Cookie").find(k_cookie) != std::string::npos) {
+        p.key        = cookie_value(req, k_cookie);
+        p.any        = !p.key.empty();
+        p.via_cookie = p.any;
+    }
+    return p;
+}
+
+// Who is asking, for the lockout: the address a proxy in front names (a
+// Cloudflare tunnel, a reverse proxy), else the connection's. A client can
+// name any address here; that only moves its own lockout, and with a random
+// key of 256 bits guessing is hopeless anyway.
+std::string client_of(const httplib::Request& req) {
+    std::string c = trim(req.get_header_value("CF-Connecting-IP"));
+    if (c.empty()) {
+        c = trim(req.get_header_value("X-Forwarded-For"));
+        const size_t comma = c.find(',');
+        if (comma != std::string::npos) {
+            c = trim(c.substr(0, comma));
+        }
+    }
+    return c.empty() ? req.remote_addr : c;
+}
+
+// Seconds the client is still locked out, or 0.
+int locked_seconds(const std::string& client) {
+    std::lock_guard<std::mutex> lock(g_fail_mutex);
+    auto it = g_failures.find(client);
+    if (it == g_failures.end()) {
+        return 0;
+    }
+    const auto now = clock_type::now();
+    if (it->second.locked_until <= now) {
+        return 0;
+    }
+    return static_cast<int>(std::chrono::duration_cast<std::chrono::seconds>(it->second.locked_until - now).count()) + 1;
+}
+
+void forget_failures(const std::string& client) {
+    std::lock_guard<std::mutex> lock(g_fail_mutex);
+    g_failures.erase(client);
+}
+
+// Counts a wrong key; returns how many came in a row.
+int count_failure(const std::string& client) {
+    std::lock_guard<std::mutex> lock(g_fail_mutex);
+    const auto now = clock_type::now();
+    for (auto it = g_failures.begin(); it != g_failures.end();) {
+        if (now - it->second.last > std::chrono::seconds(k_forget_s)) {
+            it = g_failures.erase(it);
+        } else {
+            ++it;
+        }
+    }
+    if (g_failures.size() >= k_max_clients && g_failures.find(client) == g_failures.end()) {
+        auto oldest = g_failures.begin();
+        for (auto it = g_failures.begin(); it != g_failures.end(); ++it) {
+            if (it->second.last < oldest->second.last) {
+                oldest = it;
+            }
+        }
+        g_failures.erase(oldest);
+    }
+    Failures& f = g_failures[client];
+    f.count++;
+    f.last = now;
+    if (f.count >= k_free_failures) {
+        const int shift = f.count - k_free_failures;
+        const int secs  = shift >= 6 ? k_max_lock_s : std::min(k_max_lock_s, 1 << shift);
+        f.locked_until  = now + std::chrono::seconds(secs);
+    }
+    return f.count;
+}
+
+void json_reply(httplib::Response& res, int status, const nlohmann::json& body) {
+    res.status = status;
+    res.set_content(body.dump(), "application/json");
+}
+
+void unauthorized(httplib::Response& res, const char* message) {
+    res.set_header("WWW-Authenticate", "Bearer realm=\"PS5SD\"");
+    json_reply(res, 401, {{"error", message}, {"auth_required", true}});
+}
+
+void too_many(httplib::Response& res, int seconds) {
+    res.set_header("Retry-After", std::to_string(seconds));
+    json_reply(res, 429, {{"error", "too many wrong API keys; wait " + std::to_string(seconds) + " s"}, {"auth_required", true}});
+}
+
+// Checks a presented key; counts and logs a wrong one. 0 when it is right,
+// else the status that was answered (401, 429).
+int check_key(const httplib::Request& req, httplib::Response& res, const std::string& key, const std::string& given) {
+    const std::string client = client_of(req);
+    if (const int wait = locked_seconds(client); wait > 0) {
+        too_many(res, wait);
+        return 429;
+    }
+    if (same_key(given, key)) {
+        forget_failures(client);
+        return 0;
+    }
+    const int n = count_failure(client);
+    LOG_WARN("auth: wrong API key from %s for %s %s (%d in a row)\n", client.c_str(), req.method.c_str(),
+             req.path.c_str(), n);
+    unauthorized(res, "wrong API key");
+    return 401;
+}
+
+bool is_open_route(const httplib::Request& req) {
+    const std::string& p = req.path;
+    const std::string& m = req.method;
+    if (m == "GET" || m == "HEAD") {
+        return p == "/" || p == "/ps5sd/v1/health" || p == "/ps5sd/v1/auth";
+    }
+    return m == "POST" && (p == "/ps5sd/v1/auth/login" || p == "/ps5sd/v1/auth/logout");
+}
+
+bool behind_https(const httplib::Request& req) {
+    return req.get_header_value("X-Forwarded-Proto") == "https" ||
+           req.get_header_value("CF-Visitor").find("https") != std::string::npos;
+}
+
+std::string cookie_header(const httplib::Request& req, const std::string& value, bool remove) {
+    std::string c = std::string(k_cookie) + "=" + value + "; Path=/; HttpOnly; SameSite=Strict";
+    c += remove ? "; Max-Age=0" : "; Max-Age=31536000";
+    if (behind_https(req)) {
+        c += "; Secure";
+    }
+    return c;
+}
+
+// The key as a person types it: no spaces or dashes, lower case.
+std::string normalized(const std::string& in) {
+    std::string out;
+    for (char c : in) {
+        if (c == ' ' || c == '-' || c == '\t' || c == '\r' || c == '\n') {
+            continue;
+        }
+        out.push_back(c >= 'A' && c <= 'Z' ? static_cast<char>(c - 'A' + 'a') : c);
+    }
+    return out;
+}
+
+httplib::Server::HandlerResponse guard(const httplib::Request& req, httplib::Response& res) {
+    using HR = httplib::Server::HandlerResponse;
+    // Any page may call the API with a key in a header; no credentials
+    // (cookies) across origins.
+    res.set_header("Access-Control-Allow-Origin", "*");
+    res.set_header("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS");
+    res.set_header("Access-Control-Allow-Headers", "Authorization, Content-Type, X-API-Key");
+    res.set_header("Access-Control-Max-Age", "600");
+    if (req.method == "OPTIONS") {
+        res.status = 204;
+        return HR::Handled;
+    }
+
+    const bool open         = is_open_route(req);
+    const uint64_t length   = std::strtoull(req.get_header_value("Content-Length").c_str(), nullptr, 10);
+    const bool upload       = req.method == "PUT" && starts_with(req.path, "/ps5sd/v1/app/uploads/");
+    const uint64_t max_body = open ? k_max_open_body : (upload ? UINT64_MAX : k_max_body);
+    if (length > max_body) {
+        json_reply(res, 413, {{"error", "the request body is too large (at most " + std::to_string(max_body) + " bytes)"}});
+        return HR::Handled;
+    }
+
+    const std::string key = current_key();
+    if (key.empty() || open) {
+        return HR::Unhandled;
+    }
+    const Presented given = presented_key(req);
+    if (!given.any) {
+        unauthorized(res, "this server needs an API key: Authorization: Bearer <key>");
+        return HR::Handled;
+    }
+    if (check_key(req, res, key, given.key) != 0) {
+        return HR::Handled;
+    }
+    if (given.via_cookie && req.method != "GET" && req.method != "HEAD" && !req.has_header("X-PS5SD-Request")) {
+        json_reply(res, 403, {{"error", "a request with the login cookie needs the header X-PS5SD-Request"}});
+        return HR::Handled;
+    }
+    return HR::Unhandled;
+}
+
+}  // namespace
+
+extern "C" void sd_server_set_api_key(const char* key) {
+    std::lock_guard<std::mutex> lock(g_key_mutex);
+    g_key = key != nullptr ? trim(key) : std::string();
+}
+
+bool load_api_key_file(const std::string& path) {
+    std::ifstream in(path);
+    if (!in) {
+        return false;
+    }
+    std::string line;
+    std::getline(in, line);
+    sd_server_set_api_key(line.c_str());
+    return true;
+}
+
+void install_request_guard(httplib::Server& svr) {
+    svr.set_pre_routing_handler(guard);
+
+    svr.Get("/ps5sd/v1/health", [](const httplib::Request&, httplib::Response& res) {
+        json_reply(res, 200, {{"status", "ok"}});
+    });
+
+    // Whether a key is needed, and whether this request has the right one
+    // (a wrong one is not counted here: the web UI asks on every load).
+    svr.Get("/ps5sd/v1/auth", [](const httplib::Request& req, httplib::Response& res) {
+        const std::string key = current_key();
+        const bool ok         = key.empty() || same_key(presented_key(req).key, key);
+        json_reply(res, 200, {{"required", !key.empty()}, {"authenticated", ok}});
+    });
+
+    // {"key": "..."}: sets the login cookie for the web UI.
+    svr.Post("/ps5sd/v1/auth/login", [](const httplib::Request& req, httplib::Response& res) {
+        const std::string key = current_key();
+        if (key.empty()) {
+            json_reply(res, 200, {{"ok", true}, {"required", false}});
+            return;
+        }
+        const nlohmann::json body = nlohmann::json::parse(req.body, nullptr, false);
+        if (!body.is_object() || !body.contains("key") || !body["key"].is_string()) {
+            json_reply(res, 400, {{"error", "the body must be {\"key\": \"<API key>\"}"}});
+            return;
+        }
+        const std::string raw = body["key"].get<std::string>();
+        const std::string typed = same_key(trim(raw), key) ? trim(raw) : normalized(raw);
+        if (check_key(req, res, key, typed) != 0) {
+            return;
+        }
+        res.set_header("Set-Cookie", cookie_header(req, key, false));
+        json_reply(res, 200, {{"ok", true}, {"required", true}});
+    });
+
+    svr.Post("/ps5sd/v1/auth/logout", [](const httplib::Request& req, httplib::Response& res) {
+        res.set_header("Set-Cookie", cookie_header(req, "", true));
+        json_reply(res, 200, {{"ok", true}});
+    });
+}
