@@ -0,0 +1,37 @@
+// PS5SD: what every request passes before its route: CORS, the size limit and
+// the API key.
+//
+// The key is off (every request passes) until one is set, with
+// sd_server_set_api_key() (the embedding application) or --api-key-file
+// (the plain sd-server). With a key, a request needs it in one of these:
+//   Authorization: Bearer <key>          (OpenAI clients)
+//   Authorization: Basic <user:key>      (A1111 clients with --api-auth; any user name)
+//   X-API-Key: <key>
+//   the cookie ps5sd_key, which POST /ps5sd/v1/auth/login sets (the web UI;
+//   an <img> cannot send a header). A POST, PUT or DELETE that only has the
+//   cookie also needs the header X-PS5SD-Request, which a page of another
+//   origin cannot add, so another site cannot use the cookie.
+// Without it: 401. Five wrong keys in a row from one client lock it out for
+// 1 s, then 2, 4, ... up to 60 s (429); each wrong key is logged.
+//
+// Open without a key: GET / (the web UI, which then asks for the key),
+// GET /ps5sd/v1/health, GET /ps5sd/v1/auth, POST /ps5sd/v1/auth/login and
+// /logout, and every OPTIONS (CORS preflight).
+#pragma once
+
+#include <string>
+
+#include "httplib.h"
+
+// Puts the checks in front of every route and registers the open routes above.
+// Called before the other routes are registered.
+void install_request_guard(httplib::Server& svr);
+
+// Reads the key from the first line of path; false when the file cannot be
+// read. An empty line turns the key off.
+bool load_api_key_file(const std::string& path);
+
+extern "C" {
+// The API key ("" or NULL: no key). Kept across sd_server() calls; thread-safe.
+void sd_server_set_api_key(const char* key);
+}
