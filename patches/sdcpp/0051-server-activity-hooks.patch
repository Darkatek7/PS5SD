diff --git a/examples/server/server_activity.h b/examples/server/server_activity.h
new file mode 100644
index 0000000..e344cf6
--- /dev/null
+++ b/examples/server/server_activity.h
@@ -0,0 +1,49 @@
+#pragma once
+
+#include <string>
+
+#include "common/common.h"
+#include "server_hooks.h"
+
+// One generation as seen by the activity hooks: begin() when the generation
+// starts, finish() when it is over. If finish() is never reached (an early
+// return, an exception) the destructor reports the job as failed.
+class ActivityJob {
+public:
+    ActivityJob(const char* kind, const SDGenerationParams& gen_params)
+        : kind_(kind),
+          prompt_(gen_params.prompt),
+          width_(gen_params.get_resolved_width()),
+          height_(gen_params.get_resolved_height()),
+          steps_(gen_params.sample_params.sample_steps) {}
+
+    ~ActivityJob() {
+        finish(false, "");
+    }
+
+    ActivityJob(const ActivityJob&)            = delete;
+    ActivityJob& operator=(const ActivityJob&) = delete;
+
+    void begin() {
+        if (!begun_) {
+            begun_ = true;
+            sd_activity_job_begin(kind_, prompt_.c_str(), width_, height_, steps_);
+        }
+    }
+
+    void finish(bool ok, const std::string& output_path) {
+        if (begun_ && !finished_) {
+            finished_ = true;
+            sd_activity_job_end(ok ? 1 : 0, output_path.c_str());
+        }
+    }
+
+private:
+    const char* kind_;
+    std::string prompt_;
+    int width_;
+    int height_;
+    int steps_;
+    bool begun_    = false;
+    bool finished_ = false;
+};
diff --git a/examples/server/server_hooks.cpp b/examples/server/server_hooks.cpp
new file mode 100644
index 0000000..b800b95
--- /dev/null
+++ b/examples/server/server_hooks.cpp
@@ -0,0 +1,22 @@
+// PS5SD: default (do nothing) implementations of the activity hooks. They are
+// weak: a definition of the same name in the application replaces them.
+// A hook defined in a static library is not pulled in to replace these
+// unless that library is linked with --whole-archive / -force_load; define the
+// hooks in an object file of the executable itself.
+
+#include "server_hooks.h"
+
+#if defined(__GNUC__) || defined(__clang__)
+#define SD_SERVER_WEAK __attribute__((weak))
+#else
+#define SD_SERVER_WEAK
+#endif
+
+extern "C" {
+
+SD_SERVER_WEAK void sd_activity_job_begin(const char*, const char*, int, int, int) {}
+SD_SERVER_WEAK void sd_activity_progress(int, int, float) {}
+SD_SERVER_WEAK void sd_activity_preview(const uint8_t*, int, int) {}
+SD_SERVER_WEAK void sd_activity_job_end(int, const char*) {}
+
+}
diff --git a/examples/server/server_hooks.h b/examples/server/server_hooks.h
new file mode 100644
index 0000000..0592f70
--- /dev/null
+++ b/examples/server/server_hooks.h
@@ -0,0 +1,39 @@
+// PS5SD: activity hooks.
+//
+// The server calls these around every generation. They are weak no-ops in
+// server_hooks.cpp; an embedding application (the PS5 app) defines the real
+// ones in an object file that is linked into the executable directly, and they
+// replace the no-ops. Keep this file identical to ps5/app/server_hooks.h.
+//
+// Threads: every hook is called from the thread that runs the generation
+// (the async job worker, or the HTTP thread of a synchronous request), one job
+// at a time (the generation context is locked), never concurrently with each
+// other. The pointers are only valid during the call.
+#pragma once
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// A generation starts. kind: "txt2img", "img2img", "openai_generations",
+// "openai_edits", "img_gen" or "vid_gen". prompt is UTF-8 and may be empty.
+void sd_activity_job_begin(const char* kind, const char* prompt, int w, int h, int steps);
+
+// A sampling step finished: step of steps, secs is the duration of that step
+// (seconds per iteration). Also called for the other passes of a job (hires,
+// upscale), so step may restart from 1.
+void sd_activity_progress(int step, int steps, float secs);
+
+// A preview of the image being denoised: w * h * 3 bytes, RGB, row after row.
+// Only called when the request asked for previews (the web UI does).
+void sd_activity_preview(const uint8_t* rgb, int w, int h);
+
+// The job ended. ok is 0 or 1. output_path is the first image saved to
+// --output-dir ("" when there is no --output-dir or nothing was saved; never NULL).
+void sd_activity_job_end(int ok, const char* output_path);
+
+#ifdef __cplusplus
+}
+#endif
