+
+// PS5SD: the defaults the application sets at run time, see sd_server_set_request_defaults.
+namespace {
+struct RequestDefaults {
+    int steps    = -1;
+    float cfg    = -1.0f;
+    std::string sampler;
+    std::string scheduler;
+    int width    = -1;
+    int height   = -1;
+};
+
+std::mutex g_request_defaults_mutex;
+RequestDefaults g_request_defaults;
+}  // namespace
+
+extern "C" void sd_server_set_request_defaults(int steps, float cfg, const char* sampler, const char* scheduler, int width, int height) {
+    std::lock_guard<std::mutex> lock(g_request_defaults_mutex);
+    g_request_defaults.steps     = steps;
+    g_request_defaults.cfg       = cfg;
+    g_request_defaults.sampler   = sampler != nullptr ? sampler : "";
+    g_request_defaults.scheduler = scheduler != nullptr ? scheduler : "";
+    g_request_defaults.width     = width;
+    g_request_defaults.height    = height;
+}
+
+SDGenerationParams request_defaults(const ServerRuntime& runtime) {
+    SDGenerationParams params = *runtime.default_gen_params;
+
+    std::lock_guard<std::mutex> lock(g_request_defaults_mutex);
+    if (g_request_defaults.steps > 0) {
+        params.sample_params.sample_steps = g_request_defaults.steps;
+    }
+    if (g_request_defaults.cfg >= 0) {
+        params.sample_params.guidance.txt_cfg = g_request_defaults.cfg;
+    }
+    if (!g_request_defaults.sampler.empty()) {
+        const sample_method_t method = str_to_sample_method(g_request_defaults.sampler.c_str());
+        if (method != SAMPLE_METHOD_COUNT) {
+            params.sample_params.sample_method = method;
+        }
+    }
+    if (!g_request_defaults.scheduler.empty()) {
+        const scheduler_t scheduler = str_to_scheduler(g_request_defaults.scheduler.c_str());
+        if (scheduler != SCHEDULER_COUNT) {
+            params.sample_params.scheduler = scheduler;
+        }
+    }
+    if (g_request_defaults.width > 0) {
+        params.width = g_request_defaults.width;
+    }
+    if (g_request_defaults.height > 0) {
+        params.height = g_request_defaults.height;
+    }
+    return params;
+}
diff --git a/examples/server/runtime.h b/examples/server/runtime.h
index 7946f3f..39e4ee5 100644
--- a/examples/server/runtime.h
+++ b/examples/server/runtime.h
