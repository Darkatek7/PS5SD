 examples/server/gallery.h         |  8 ++-
 examples/server/routes_openai.cpp |  8 ++-
 examples/server/routes_sdapi.cpp  | 10 +++-
 examples/server/routes_sdcpp.cpp  | 14 +++--
 examples/server/server_hooks.h    |  3 +
 8 files changed, 142 insertions(+), 11 deletions(-)

