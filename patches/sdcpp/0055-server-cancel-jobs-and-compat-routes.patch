+++ b/examples/server/async_jobs.cpp
@@ -419,7 +419,7 @@ void async_job_worker(ServerRuntime& runtime) {
             }
 
             job->completed_at = unix_timestamp_now();
-            if (ok) {
+            if (ok && !job->cancel_requested) {
                 job->status                 = AsyncJobStatus::Completed;
                 job->result_images_b64      = std::move(output_images);
                 job->result_media_b64       = std::move(output_media_b64);
@@ -428,6 +428,15 @@ void async_job_worker(ServerRuntime& runtime) {
                 job->result_fps             = output_fps;
                 job->error_code.clear();
                 job->error_message.clear();
+            } else if (job->cancel_requested) {
+                job->status        = AsyncJobStatus::Cancelled;
+                job->error_code    = "cancelled";
+                job->error_message = "job cancelled by client";
+                job->result_images_b64.clear();
+                job->result_media_b64.clear();
+                job->result_media_mime_type.clear();
+                job->result_frame_count = 0;
+                job->result_fps         = 0;
             } else {
                 job->status        = AsyncJobStatus::Failed;
                 job->error_code    = "generation_failed";
diff --git a/examples/server/async_jobs.h b/examples/server/async_jobs.h
index 2fe79bb..b10959c 100644
--- a/examples/server/async_jobs.h
+++ b/examples/server/async_jobs.h
@@ -49,6 +49,8 @@ struct AsyncGenerationJob {
     int preview_pass          = 0;
     int preview_step          = 0;
     int preview_total_steps   = 0;
+    // PS5SD: set when a client cancels the job while it generates.
+    bool cancel_requested = false;
 };
 
 struct AsyncJobManager {
diff --git a/examples/server/gallery.cpp b/examples/server/gallery.cpp
index 58c7663..25fc822 100644
--- a/examples/server/gallery.cpp
+++ b/examples/server/gallery.cpp
@@ -17,6 +17,7 @@
 #include "common/media_io.h"
 #include "gallery.h"
 #include "routes.h"
+#include "async_jobs.h"
 #include "server_hooks.h"
 
 namespace fs = std::filesystem;
@@ -121,8 +122,104 @@ static void app_route(const httplib::Request& req, httplib::Response& res) {
     std::free(out);
 }
 
+bool app_compat_route(const char* name, const httplib::Request& req, httplib::Response& res) {
+    char* out              = nullptr;
+    size_t out_len         = 0;
+    const char* type       = nullptr;
+    const std::string path = std::string("compat/") + name;
+    const int status       = sd_app_request(req.method.c_str(), path.c_str(), req.body.data(), req.body.size(),
+                                            &out, &out_len, &type);
+    if (status > 0) {
+        res.status = status;
+        res.set_content(out != nullptr ? std::string(out, out_len) : std::string(),
+                        type != nullptr ? type : "application/json");
+    }
+    std::free(out);
+    return status > 0;
+}
+
+// The queued and generating async jobs, without their images.
+static json active_jobs_json(const AsyncJobManager& manager) {
+    json jobs = json::array();
+    for (const auto& kv : manager.jobs) {
+        const AsyncGenerationJob& job = *kv.second;
+        if (job.status != AsyncJobStatus::Queued && job.status != AsyncJobStatus::Generating) {
+            continue;
+        }
+        json j = make_async_job_json(manager, job);
+        j.erase("preview");
+        j.erase("result");
+        j["prompt"]           = job.kind == AsyncJobKind::VidGen ? job.vid_gen.gen_params.prompt : job.img_gen.gen_params.prompt;
+        j["cancel_requested"] = job.cancel_requested;
+        jobs.push_back(j);
+    }
+    std::sort(jobs.begin(), jobs.end(), [](const json& a, const json& b) { return a["created"] < b["created"]; });
+    return jobs;
+}
+
+// Stops the generation that runs now, whichever API started it. sd.cpp
+// clears the flag when the next generation starts, so a stop with nothing
+// running is harmless.
+static bool interrupt_generation(ServerRuntime& rt) {
+    bool async_job = false;
+    {
+        std::lock_guard<std::mutex> lock(rt.async_job_manager->mutex);
+        for (auto& kv : rt.async_job_manager->jobs) {
+            if (kv.second->status == AsyncJobStatus::Generating) {
+                kv.second->cancel_requested = true;
+                async_job                   = true;
+            }
+        }
+    }
+    sd_cancel_generation(rt.sd_ctx, SD_CANCEL_ALL);
+    return async_job;
+}
+
 void register_ps5sd_endpoints(httplib::Server& svr, ServerRuntime& rt) {
     const SDSvrParams* svr_params = rt.svr_params;
+    ServerRuntime* runtime        = &rt;
+
+    // A1111: switching the model is the application's (sd_app_request).
+    svr.Post("/sdapi/v1/options", [](const httplib::Request& req, httplib::Response& res) {
+        if (!app_compat_route("options", req, res)) {
+            res.status = 200;
+            res.set_content("{}", "application/json");
+        }
+    });
+
+    // A1111: stop the generation that runs (skip does the same here).
+    for (const char* route : {"/sdapi/v1/interrupt", "/sdapi/v1/skip"}) {
+        svr.Post(route, [runtime](const httplib::Request&, httplib::Response& res) {
+            interrupt_generation(*runtime);
+            res.status = 200;
+            res.set_content("{}", "application/json");
+        });
+    }
+
+    //   GET  /ps5sd/v1/jobs         the queued and generating async jobs
+    //   POST /ps5sd/v1/jobs/cancel  cancel all of them and stop what runs now
+    svr.Get("/ps5sd/v1/jobs", [runtime](const httplib::Request&, httplib::Response& res) {
+        std::lock_guard<std::mutex> lock(runtime->async_job_manager->mutex);
+        res.set_content(json({{"jobs", active_jobs_json(*runtime->async_job_manager)}}).dump(), "application/json");
+    });
+    svr.Post("/ps5sd/v1/jobs/cancel", [runtime](const httplib::Request&, httplib::Response& res) {
+        int queued = 0;
+        {
+            AsyncJobManager& manager = *runtime->async_job_manager;
+            std::lock_guard<std::mutex> lock(manager.mutex);
+            const std::deque<std::string> ids = manager.queue;
+            for (const auto& id : ids) {
+                auto it = manager.jobs.find(id);
+                if (it != manager.jobs.end() && it->second->status == AsyncJobStatus::Queued &&
+                    cancel_queued_job(manager, *it->second)) {
+                    ++queued;
+                }
+            }
+        }
+        interrupt_generation(*runtime);
+        res.status = 200;
+        res.set_content(json({{"cancelled_queued", queued}, {"interrupted", true}}).dump(), "application/json");
+    });
 
     svr.Get(R"(/ps5sd/v1/app/(.+))", app_route);
     svr.Post(R"(/ps5sd/v1/app/(.+))", app_route);
