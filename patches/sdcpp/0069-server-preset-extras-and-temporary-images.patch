+// The loaded preset's name in an image's parameters: "Preset: <name>, " before
+// "Version:" in A1111's text, and "ps5sd": {"preset"} in sd.cpp's JSON at its
+// end. The text as it is without a preset, or when it has no such places.
+static std::string with_preset(const std::string& parameters) {
+    std::string name = preset_name_now();
+    if (name.empty() || parameters.empty()) {
+        return parameters;
+    }
+    for (char& c : name) {
+        if (c == ',' || c == '\n' || c == '\r') {
+            c = ' ';
+        }
+    }
+    std::string out     = parameters;
+    const size_t at_json = out.rfind(", SDCPP: {");
+    if (at_json != std::string::npos) {
+        json j = json::parse(out.substr(at_json + 9), nullptr, false);
+        if (j.is_object()) {
+            j["ps5sd"] = {{"preset", name}};
+            out        = out.substr(0, at_json) + ", SDCPP: " + j.dump(-1, ' ', false, json::error_handler_t::replace);
+        }
+    }
+    const size_t at_version = out.rfind("Version: stable-diffusion.cpp", at_json);  // npos: the whole text
+    if (at_version != std::string::npos) {
+        out.insert(at_version, "Preset: " + name + ", ");
+    }
+    return out;
+}
