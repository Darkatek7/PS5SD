diff --git a/examples/server/runtime.cpp b/examples/server/runtime.cpp
index 460a42f..0407750 100644
--- a/examples/server/runtime.cpp
+++ b/examples/server/runtime.cpp
@@ -3,6 +3,7 @@
 #include <algorithm>
 #include <cctype>
 #include <chrono>
+#include <cstring>
 #include <cstdlib>
 #include <filesystem>
 #include <mutex>
@@ -435,8 +436,65 @@ struct RequestDefaults {
 
 std::mutex g_request_defaults_mutex;
 RequestDefaults g_request_defaults;
+
+struct PresetExtras {
+    int clip_skip = -1;
+    std::string prompt_starter;
+    std::string negative_starter;
+    std::string name;
+};
+
+PresetExtras g_preset_extras;  // under g_request_defaults_mutex
+
+// text with starter in front ("starter, text"), unless it starts with starter already
+std::string with_starter(const std::string& starter, const std::string& text) {
+    if (starter.empty() || text.compare(0, starter.size(), starter) == 0) {
+        return text;
+    }
+    if (text.find_first_not_of(" \t\r\n") == std::string::npos) {
+        return starter;
+    }
+    const bool joined = starter.back() == ',' || starter.back() == ' ';
+    return starter + (joined ? "" : ", ") + text;
+}
 }  // namespace
 
+extern "C" void sd_server_set_preset_extras(int clip_skip, const char* prompt_starter, const char* negative_starter,
+                                            const char* preset_name) {
+    std::lock_guard<std::mutex> lock(g_request_defaults_mutex);
+    g_preset_extras.clip_skip        = clip_skip;
+    g_preset_extras.prompt_starter   = prompt_starter != nullptr ? prompt_starter : "";
+    g_preset_extras.negative_starter = negative_starter != nullptr ? negative_starter : "";
+    g_preset_extras.name             = preset_name != nullptr ? preset_name : "";
+}
+
+void apply_preset_extras(const ServerRuntime& runtime, SDGenerationParams& params) {
+    {
+        std::lock_guard<std::mutex> lock(g_request_defaults_mutex);
+        params.prompt          = with_starter(g_preset_extras.prompt_starter, params.prompt);
+        params.negative_prompt = with_starter(g_preset_extras.negative_starter, params.negative_prompt);
+    }
+    // CLIP skip 1 reads the text encoder's last layer, which only SD 1.x models are made for. With it an
+    // SDXL model makes pure noise (measured on the console), so every other model keeps its own (2 for
+    // SDXL), as AUTOMATIC1111 ignores the setting for SDXL.
+    if (params.clip_skip == 1) {
+        const char* version = sd_get_model_version_name(runtime.sd_ctx);
+        if (version == nullptr || std::strncmp(version, "SD 1", 4) != 0) {
+            params.clip_skip = -1;
+        }
+    }
+}
+
+std::string preset_name_now() {
+    std::lock_guard<std::mutex> lock(g_request_defaults_mutex);
+    return g_preset_extras.name;
+}
+
+bool request_is_temporary(const json& body) {
+    return body.is_object() && body.contains("temporary") && body["temporary"].is_boolean() &&
+           body["temporary"].get<bool>();
+}
+
 extern "C" void sd_server_set_request_defaults(int steps, float cfg, const char* sampler, const char* scheduler, int width, int height) {
     std::lock_guard<std::mutex> lock(g_request_defaults_mutex);
     g_request_defaults.steps     = steps;
@@ -475,5 +533,8 @@ SDGenerationParams request_defaults(const ServerRuntime& runtime) {
     if (g_request_defaults.height > 0) {
         params.height = g_request_defaults.height;
     }
+    if (g_preset_extras.clip_skip > 0) {
+        params.clip_skip = g_preset_extras.clip_skip;
+    }
     return params;
 }
