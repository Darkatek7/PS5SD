     std::string output_format = "webm";
     int output_compression    = 100;
     std::string preview_mode  = "none";
@@ -115,3 +117,18 @@ int64_t unix_timestamp_now();
 extern "C" void sd_server_set_request_defaults(int steps, float cfg, const char* sampler, const char* scheduler, int width, int height);
 // A copy of the command line's defaults with the run-time ones (sd_server_set_request_defaults) applied.
 SDGenerationParams request_defaults(const ServerRuntime& runtime);
+
+// PS5SD: more of the loaded preset, set at run time: its CLIP skip (1 or more; -1 for sd.cpp's own,
+// which is 2 for SDXL and SD2, 1 for SD 1.5), its prompt starters (text the prompt and the negative
+// prompt of every request start with) and its name (in each saved image's parameters). NULL or ""
+// for none.
+extern "C" void sd_server_set_preset_extras(int clip_skip, const char* prompt_starter, const char* negative_starter,
+                                            const char* preset_name);
+// The prompt starters before the request's prompt and negative prompt, each joined with ", "; not
+// before a prompt that starts with its starter already (a prompt taken from an image made with it).
+// And a CLIP skip of 1 only for an SD 1.x model: the others get their own (see runtime.cpp).
+void apply_preset_extras(const ServerRuntime& runtime, SDGenerationParams& params);
+// The loaded preset's name, "" for none.
+std::string preset_name_now();
+// "temporary": true in a request body (img_gen, vid_gen).
+bool request_is_temporary(const json& body);
