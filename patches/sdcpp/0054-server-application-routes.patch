 #include <ctime>
 #include <filesystem>
 #include <fstream>
@@ -16,6 +17,7 @@
 #include "common/media_io.h"
 #include "gallery.h"
 #include "routes.h"
+#include "server_hooks.h"
 
 namespace fs = std::filesystem;
 
@@ -100,9 +102,32 @@ struct GalleryEntry {
 
 }  // namespace
 
+// /ps5sd/v1/app/<path>: handed to the application (sd_app_request).
+static void app_route(const httplib::Request& req, httplib::Response& res) {
+    char* out              = nullptr;
+    size_t out_len         = 0;
+    const char* type       = nullptr;
+    const std::string path = req.matches[1];
+    const int status       = sd_app_request(req.method.c_str(), path.c_str(), req.body.data(), req.body.size(),
+                                            &out, &out_len, &type);
+    if (status <= 0) {
+        res.status = 404;
+        res.set_content("{\"error\":\"not found\"}", "application/json");
+    } else {
+        res.status = status;
+        res.set_content(out != nullptr ? std::string(out, out_len) : std::string(),
+                        type != nullptr ? type : "application/json");
+    }
+    std::free(out);
+}
+
 void register_ps5sd_endpoints(httplib::Server& svr, ServerRuntime& rt) {
     const SDSvrParams* svr_params = rt.svr_params;
 
+    svr.Get(R"(/ps5sd/v1/app/(.+))", app_route);
+    svr.Post(R"(/ps5sd/v1/app/(.+))", app_route);
+    svr.Delete(R"(/ps5sd/v1/app/(.+))", app_route);
+
     svr.Get("/ps5sd/v1/gallery", [svr_params](const httplib::Request& req, httplib::Response& res) {
         size_t limit = 100;
         if (req.has_param("limit")) {
diff --git a/examples/server/server_hooks.cpp b/examples/server/server_hooks.cpp
