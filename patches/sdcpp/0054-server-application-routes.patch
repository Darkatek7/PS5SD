Subject: [PATCH] server: /ps5sd/v1/app/<path> handed to the application
 (sd_app_request)

---
 examples/server/gallery.cpp      | 25 +++++++++++++++++++++++++
 examples/server/server_hooks.cpp |  3 +++
 examples/server/server_hooks.h   | 10 ++++++++++
 3 files changed, 38 insertions(+)

diff --git a/examples/server/gallery.cpp b/examples/server/gallery.cpp
index eb5fbb2..e8fb0f5 100644
--- a/examples/server/gallery.cpp
+++ b/examples/server/gallery.cpp
@@ -8,6 +8,7 @@
 #include <atomic>
 #include <chrono>
 #include <cstdio>
