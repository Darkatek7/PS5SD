diff --git a/examples/server/events.cpp b/examples/server/events.cpp
new file mode 100644
index 0000000..51e5eca
--- /dev/null
+++ b/examples/server/events.cpp
@@ -0,0 +1,291 @@
+#include "events.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <condition_variable>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <set>
+#include <string>
+
+#include "httplib.h"
+
+#include "api_error.h"
+#include "async_jobs.h"
+#include "runtime.h"
+
+using json = nlohmann::json;
+
+namespace {
+
+constexpr int k_max_streams = 4;
+constexpr auto k_wake       = std::chrono::seconds(1);
+constexpr auto k_ping       = std::chrono::seconds(15);
+// at most four progress events a second
+constexpr auto k_progress_gap = std::chrono::milliseconds(250);
+
+std::mutex g_mutex;
+std::condition_variable g_cv;
+uint64_t g_change = 0;  // counts notifies and steps
+bool g_stop       = false;
+int g_streams     = 0;
+
+struct Progress {
+    uint64_t seq = 0;  // 0: no step since the start
+    int step     = 0;
+    int steps    = 0;
+    float secs   = 0;
+};
+Progress g_progress;
+
+std::string dump(const json& j) {
+    return j.dump(-1, ' ', false, json::error_handler_t::replace);
+}
+
+bool active(const AsyncGenerationJob& job) {
+    return job.status == AsyncJobStatus::Queued || job.status == AsyncJobStatus::Generating;
+}
+
+// One job for the jobs event, as GET /ps5sd/v1/jobs lists it. manager.mutex is held.
+json job_summary(const AsyncJobManager& manager, const AsyncGenerationJob& job) {
+    json j = {
+        {"id", job.id},
+        {"kind", async_job_kind_name(job.kind)},
+        {"status", async_job_status_name(job.status)},
+        {"created", job.created_at},
+        {"started", job.started_at == 0 ? json(nullptr) : json(job.started_at)},
+        {"queue_position", 0},
+        {"prompt", job.kind == AsyncJobKind::VidGen ? job.vid_gen.gen_params.prompt : job.img_gen.gen_params.prompt},
+        {"cancel_requested", job.cancel_requested},
+    };
+    if (job.status == AsyncJobStatus::Queued) {
+        const auto it = std::find(manager.queue.begin(), manager.queue.end(), job.id);
+        if (it != manager.queue.end()) {
+            j["queue_position"] = (it - manager.queue.begin()) + 1;
+        }
+    }
+    if (job.kind == AsyncJobKind::ImgGen && job.repeat_total > 1) {
+        j["repeat"] = {{"total", job.repeat_total}, {"done", job.repeat_done}};
+    }
+    return j;
+}
+
+// The job event of a job that ended. manager.mutex is held.
+json job_end(const AsyncGenerationJob& job) {
+    json error = nullptr;
+    if (job.status == AsyncJobStatus::Failed || job.status == AsyncJobStatus::Cancelled) {
+        error = {
+            {"code", job.error_code.empty()
+                         ? (job.status == AsyncJobStatus::Cancelled ? "cancelled" : "generation_failed")
+                         : job.error_code},
+            {"message", job.error_message},
+        };
+    }
+    json j = {
+        {"id", job.id},
+        {"kind", async_job_kind_name(job.kind)},
+        {"status", async_job_status_name(job.status)},
+        {"completed", job.completed_at == 0 ? json(nullptr) : json(job.completed_at)},
+        {"error", error},
+    };
+    if (job.kind == AsyncJobKind::ImgGen && job.repeat_total > 1) {
+        j["saved"] = job.repeat_saved;
+    }
+    return j;
+}
+
+// seconds to the millisecond
+double rounded(double secs) {
+    return std::round(secs * 1000.0) / 1000.0;
+}
+
+std::string event(const char* name, const json& data) {
+    return std::string("event: ") + name + "\ndata: " + dump(data) + "\n\n";
+}
+
+// What one stream has sent so far.
+struct Stream {
+    std::string only;               // ?job=<id>, or every job
+    std::string jobs_sent;          // the last jobs event's data
+    std::set<std::string> running;  // the active jobs it saw
+    uint64_t change        = 0;
+    uint64_t progress_seq  = 0;
+    bool first             = true;
+    bool done              = false;  // the ?job= job's event is out
+    std::chrono::steady_clock::time_point progress_at;
+    std::chrono::steady_clock::time_point ping_at = std::chrono::steady_clock::now();
+};
+
+// Everything new since the stream's last call, as event text; "" for nothing.
+std::string next_events(Stream& s, AsyncJobManager& manager, const Progress& progress) {
+    std::string out;
+    std::lock_guard<std::mutex> lock(manager.mutex);
+
+    json jobs = json::array();
+    std::set<std::string> running;
+    std::string generating;
+    std::string generating_kind;
+    for (const auto& kv : manager.jobs) {
+        const AsyncGenerationJob& job = *kv.second;
+        if (!active(job)) {
+            continue;
+        }
+        if (job.status == AsyncJobStatus::Generating) {
+            generating      = job.id;
+            generating_kind = async_job_kind_name(job.kind);
+        }
+        if (!s.only.empty() && job.id != s.only) {
+            continue;
+        }
+        running.insert(job.id);
+        jobs.push_back(job_summary(manager, job));
+    }
+    std::sort(jobs.begin(), jobs.end(), [](const json& a, const json& b) { return a["created"] < b["created"]; });
+
+    // the jobs that ended since the last call, then the list
+    std::set<std::string> ended;
+    for (const std::string& id : s.running) {
+        if (running.count(id) == 0) {
+            ended.insert(id);
+        }
+    }
+    if (s.first && !s.only.empty() && running.empty()) {
+        ended.insert(s.only);  // it ended before the stream opened
+    }
+    for (const std::string& id : ended) {
+        const auto it = manager.jobs.find(id);
+        if (it != manager.jobs.end() && !active(*it->second)) {
+            out += event("job", job_end(*it->second));
+        }
+        if (id == s.only) {
+            s.done = true;
+        }
+    }
+    s.running = running;
+
+    const json list      = {{"jobs", jobs}};
+    const std::string js = dump(list);
+    if (!s.done && (s.first || js != s.jobs_sent)) {
+        out += event("jobs", list);
+        s.jobs_sent = js;
+    }
+    if (s.first && generating.empty()) {
+        s.progress_seq = progress.seq;  // the steps of a run that is over: nothing for a new stream
+    }
+    s.first = false;
+
+    const auto now = std::chrono::steady_clock::now();
+    if (!s.done && progress.seq != 0 && progress.seq != s.progress_seq && now - s.progress_at >= k_progress_gap &&
+        (s.only.empty() || s.only == generating)) {
+        s.progress_seq = progress.seq;
+        s.progress_at  = now;
+        const int left = std::max(0, progress.steps - progress.step);
+        out += event("progress", {
+                                     {"job", generating.empty() ? json(nullptr) : json(generating)},
+                                     {"kind", generating.empty() ? json(nullptr) : json(generating_kind)},
+                                     {"step", progress.step},
+                                     {"steps", progress.steps},
+                                     {"seconds_per_step", rounded(progress.secs)},
+                                     {"eta_seconds", progress.secs > 0 ? json(rounded(left * progress.secs)) : json(nullptr)},
+                                 });
+    }
+    return out;
+}
+
+}  // namespace
+
+void sd_events_progress(int step, int steps, float secs) {
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        g_progress.seq++;
+        g_progress.step  = step;
+        g_progress.steps = steps;
+        g_progress.secs  = secs;
+        g_change++;
+    }
+    g_cv.notify_all();
+}
+
+void sd_events_notify() {
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        g_change++;
+    }
+    g_cv.notify_all();
+}
+
+void sd_events_stop(bool stop) {
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        g_stop = stop;
+    }
+    g_cv.notify_all();
+}
+
+void register_event_endpoints(httplib::Server& svr, ServerRuntime& rt) {
+    AsyncJobManager* manager = rt.async_job_manager;
+    svr.Get("/ps5sd/v1/events", [manager](const httplib::Request& req, httplib::Response& res) {
+        auto stream  = std::make_shared<Stream>();
+        stream->only = req.has_param("job") ? req.get_param_value("job") : "";
+        if (!stream->only.empty()) {
+            std::lock_guard<std::mutex> lock(manager->mutex);
+            if (manager->jobs.count(stream->only) == 0) {
+                send_api_error(res, 404, "not_found", "no job " + stream->only);
+                return;
+            }
+        }
+        {
+            std::lock_guard<std::mutex> lock(g_mutex);
+            if (g_streams >= k_max_streams) {
+                send_api_error(res, 429, "too_many_streams",
+                               "at most " + std::to_string(k_max_streams) + " event streams are open at once");
+                return;
+            }
+            g_streams++;
+        }
+        res.set_header("Cache-Control", "no-cache");
+        res.set_header("X-Accel-Buffering", "no");  // nginx: do not hold the events back
+        res.set_chunked_content_provider(
+            "text/event-stream",
+            [manager, stream](size_t, httplib::DataSink& sink) {
+                Progress progress;
+                {
+                    std::unique_lock<std::mutex> lock(g_mutex);
+                    if (!stream->first) {
+                        g_cv.wait_for(lock, k_wake, [&] { return g_stop || g_change != stream->change; });
+                    }
+                    if (g_stop) {
+                        sink.done();
+                        return true;
+                    }
+                    stream->change = g_change;
+                    progress       = g_progress;
+                }
+                // a client that went away (a closed tab) frees its stream within a second, not at the next ping
+                if (!sink.is_writable()) {
+                    return false;
+                }
+                std::string out = next_events(*stream, *manager, progress);
+                const auto now  = std::chrono::steady_clock::now();
+                if (out.empty() && now - stream->ping_at >= k_ping) {
+                    out = ": ping\n\n";
+                }
+                if (!out.empty()) {
+                    stream->ping_at = now;
+                    if (!sink.write(out.data(), out.size())) {
+                        return false;  // the client went away
+                    }
+                }
+                if (stream->done) {
+                    sink.done();
+                }
+                return true;
+            },
+            [](bool) {
+                std::lock_guard<std::mutex> lock(g_mutex);
+                g_streams--;
+            });
+    });
+}
diff --git a/examples/server/events.h b/examples/server/events.h
new file mode 100644
index 0000000..bb8be0d
--- /dev/null
+++ b/examples/server/events.h
@@ -0,0 +1,39 @@
+// PS5SD: GET /ps5sd/v1/events, the jobs and their progress as server-sent
+// events (text/event-stream), instead of polling GET /ps5sd/v1/jobs and
+// GET /sdcpp/v1/jobs/<id>:
+//
+//   event: jobs      {"jobs": [...]}: the queued and generating jobs, as
+//                    GET /ps5sd/v1/jobs lists them; first when the stream
+//                    opens, then whenever that list changes
+//   event: progress  {"job", "kind", "step", "steps", "seconds_per_step",
+//                    "eta_seconds"}: a step of what runs now is done, at most
+//                    four a second. sd.cpp counts every phase from 1: loading
+//                    the weights (on the first run after a start), the
+//                    sampling, the decoding of the tiles, an upscale. "job" is
+//                    the async job's id, null for a synchronous request
+//                    (txt2img, ...)
+//   event: job       {"id", "kind", "status", "completed", "error", "saved"}:
+//                    a job ended (completed, failed or cancelled); its images
+//                    or video are in GET /sdcpp/v1/jobs/<id>
+//   : ping           a comment every 15 s, so a proxy keeps the stream open
+//
+// ?job=<id> sends only what concerns that job, and ends the stream after its
+// job event (at once when it has ended already; 404 when there is no such
+// job). A change shows at most a second late. At most four streams are open
+// at once (each holds one of the server's threads); a fifth is answered 429
+// too_many_streams. The streams end when the server stops (a model switch).
+#pragma once
+
+namespace httplib {
+class Server;
+}
+struct ServerRuntime;
+
+void register_event_endpoints(httplib::Server& svr, ServerRuntime& rt);
+
+// A step is done (sd_progress_cb).
+void sd_events_progress(int step, int steps, float secs);
+// The jobs changed: one was queued, started or ended.
+void sd_events_notify();
+// true: the server stops, every stream ends; false: a new server starts.
+void sd_events_stop(bool stop);
