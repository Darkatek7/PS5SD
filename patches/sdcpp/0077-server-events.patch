 #include "common/common.h"
 #include "common/resource_owners.hpp"
 #include "routes.h"
@@ -84,6 +85,7 @@ static int parse_args(int argc,
 // keeps a one-line progress on stderr.
 static void sd_progress_cb(int step, int steps, float secs, void*) {
     sd_activity_progress(step, steps, secs);
+    sd_events_progress(step, steps, secs);
     if (step > 0) {
         fprintf(stderr, "\rstep %d/%d (%.2fs/it)\033[K%s", step, steps, secs, step == steps ? "\n" : "");
         fflush(stderr);
@@ -193,6 +195,7 @@ static int sd_server_standby(int argc, const char** argv) {
     install_error_shape(svr);
     register_index_endpoints(svr, svr_params, embedded_index_html());
     register_ps5sd_endpoints(svr, runtime);
+    register_event_endpoints(svr, runtime);
     const auto no_model = [](const httplib::Request&, httplib::Response& res) {
         send_api_error(res, 503, "standby", "no model is loaded; pick or download one in the web UI, tab Models");
     };
@@ -208,11 +211,13 @@ static int sd_server_standby(int argc, const char** argv) {
         LOG_ERROR("could not listen on %s:%d\n", svr_params.listen_ip.c_str(), svr_params.listen_port);
     }
     g_sd_server_stop = false;
+    sd_events_stop(false);
     return served ? 0 : 1;
 }
 
 extern "C" void sd_server_terminate(void) {
     g_sd_server_stop = true;
+    sd_events_stop(true);
     httplib::Server* svr = g_sd_server_svr.load();
     if (svr != nullptr) {
         svr->stop();
@@ -260,6 +265,7 @@ extern "C" int sd_server(int argc, char** argv_in) {
         LOG_ERROR("new_sd_ctx_t failed");
         sd_set_log_callback(nullptr, nullptr);
         g_sd_server_stop = false;
+        sd_events_stop(false);
         return 1;
     }
 
@@ -296,6 +302,7 @@ extern "C" int sd_server(int argc, char** argv_in) {
     register_sdapi_endpoints(svr, runtime);
     register_sdcpp_api_endpoints(svr, runtime);
     register_ps5sd_endpoints(svr, runtime);
+    register_event_endpoints(svr, runtime);
 
     LOG_INFO("listening on: http://%s:%d\n", svr_params.listen_ip.c_str(), svr_params.listen_port);
     g_sd_server_svr = &svr;
@@ -314,6 +321,7 @@ extern "C" int sd_server(int argc, char** argv_in) {
     sd_set_progress_callback(nullptr, nullptr);
     sd_set_log_callback(nullptr, nullptr);
     g_sd_server_stop = false;
+    sd_events_stop(false);
     return served ? 0 : 1;
 }
 
