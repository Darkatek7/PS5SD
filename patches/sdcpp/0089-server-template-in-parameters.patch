 examples/server/gallery.cpp      | 40 +++++++++++++++++++++++++++++++++-------
 examples/server/gallery.h        |  7 +++++--
 examples/server/routes_sdcpp.cpp |  6 ++++++
 examples/server/runtime.cpp      | 29 +++++++++++++++++++++++++++++
 examples/server/runtime.h        | 20 ++++++++++++++++++++
 6 files changed, 96 insertions(+), 11 deletions(-)

