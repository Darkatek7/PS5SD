@@ -175,11 +175,23 @@ static bool write_thumbnail(const fs::path& dir, const std::string& name, const
 // ActivityJob::begin, to this save) in an image's parameters: "Preset: <name>, Time: 52.3 s, "
 // before "Version:" in A1111's text, and "ps5sd": {"preset", "seconds"} in
 // sd.cpp's JSON at its end; an empty "Model: " gets the diffusion model's name.
-// The text as it is without a preset and a time, or when it has no such places.
-static std::string with_preset(const std::string& parameters) {
+// The request's template and negative template go in front of them ("Template: <t>, Negative Template: <n>, ")
+// and into the same JSON object. The text as it is without any of these, or when it has no such places.
+// A1111's quote() of a value: as it is, or a JSON string when it has a comma, a colon, a quote or a line break
+// (an empty one too: "").
+static std::string quote_parameter(const std::string& value) {
+    if (!value.empty() && value.find_first_of(",:\"\r\n") == std::string::npos) {
+        return value;
+    }
+    return json(value).dump(-1, ' ', true, json::error_handler_t::replace);
+}
+
+static std::string with_preset(const std::string& parameters, const PromptTemplate* tmpl = nullptr) {
     std::string name     = preset_name_now();
     const double seconds = sd_server_generation_seconds();
-    if ((name.empty() && seconds < 0) || parameters.empty()) {
+    const bool has_template = tmpl != nullptr && !tmpl->prompt.empty();
+    const bool has_negative = tmpl != nullptr && tmpl->has_negative;
+    if ((name.empty() && seconds < 0 && !has_template && !has_negative) || parameters.empty()) {
         return parameters;
     }
     for (char& c : name) {
@@ -200,6 +212,12 @@ static std::string with_preset(const std::string& parameters) {
             if (seconds >= 0) {
                 extra["seconds"] = tenths;
             }
+            if (has_template) {
+                extra["template"] = tmpl->prompt;
+            }
+            if (has_negative) {
+                extra["negative_template"] = tmpl->negative;
+            }
             j["ps5sd"] = extra;
             out        = out.substr(0, at_json) + ", SDCPP: " + j.dump(-1, ' ', false, json::error_handler_t::replace);
         }
@@ -207,6 +225,12 @@ static std::string with_preset(const std::string& parameters) {
     const size_t at_version = out.rfind("Version: stable-diffusion.cpp", at_json);  // npos: the whole text
     if (at_version != std::string::npos) {
         std::string add;
+        if (has_template) {
+            add += "Template: " + quote_parameter(tmpl->prompt) + ", ";
+        }
+        if (has_negative) {
+            add += "Negative Template: " + quote_parameter(tmpl->negative) + ", ";
+        }
         if (!name.empty()) {
             add += "Preset: " + name + ", ";
         }
@@ -277,7 +301,8 @@ std::vector<std::string> save_output_images(const SDSvrParams& svr_params,
                                             SDImageVec& images,
                                             const SDContextParams* ctx_params,
                                             const SDGenerationParams* gen_params,
-                                            bool temporary) {
+                                            bool temporary,
+                                            const PromptTemplate* prompt_template) {
     std::vector<std::string> saved;
     if (svr_params.output_dir.empty()) {
         return saved;
@@ -298,7 +323,7 @@ std::vector<std::string> save_output_images(const SDSvrParams& svr_params,
             continue;
         }
         // A1111's text of the image's own generation info (its seed, its LoRAs), sd.cpp's JSON of it at the end
-        const std::string parameters = known ? with_preset(generation_info_to_image_metadata(images.generation_info(i))) : "";
+        const std::string parameters = known ? with_preset(generation_info_to_image_metadata(images.generation_info(i)), prompt_template) : "";
         std::vector<uint8_t> bytes   = png_with_parameters(encode_image_to_vector(EncodedImageFormat::PNG,
                                                                                 image.data,
                                                                                 image.width,
@@ -336,8 +361,9 @@ std::string save_output_video(const SDSvrParams& svr_params,
                               const std::string& format,
                               const std::string& parameters_in,
                               const sd_image_t* first_frame,
-                              bool temporary) {
-    const std::string parameters = with_preset(parameters_in);
+                              bool temporary,
+                              const PromptTemplate* prompt_template) {
