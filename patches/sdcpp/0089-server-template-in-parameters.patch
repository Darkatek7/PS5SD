+    }
     apply_preset_extras(runtime, request.gen_params);
     // Intentionally disable prompt-embedded LoRA tag parsing for server APIs.
     if (!request.gen_params.resolve_and_validate(VID_GEN, "", runtime.ctx_params->hires_upscalers_dir, true)) {
diff --git a/examples/server/runtime.cpp b/examples/server/runtime.cpp
index 3f0fbc7..a01296b 100644
--- a/examples/server/runtime.cpp
+++ b/examples/server/runtime.cpp
@@ -683,6 +683,35 @@ bool request_is_temporary(const json& body) {
            body["temporary"].get<bool>();
 }
 
+bool parse_prompt_template(const json& body, PromptTemplate& out, std::string& error_message) {
+    out = PromptTemplate();
+    if (!body.is_object()) {
+        return true;
+    }
+    const struct {
+        const char* key;
+        std::string* value;
+    } fields[] = {{"template", &out.prompt}, {"negative_template", &out.negative}};
+    for (const auto& field : fields) {
+        if (!body.contains(field.key) || body[field.key].is_null()) {
+            continue;
+        }
+        if (!body[field.key].is_string()) {
+            error_message = std::string(field.key) + " must be a string";
+            return false;
+        }
+        *field.value = body[field.key].get<std::string>();
+        if (field.value == &out.negative) {
+            out.has_negative = true;
+        }
+        if (field.value->size() > k_max_template_bytes) {
+            error_message = std::string(field.key) + " is at most " + std::to_string(k_max_template_bytes) + " bytes";
+            return false;
+        }
+    }
+    return true;
+}
+
 extern "C" void sd_server_set_request_defaults(int steps, float cfg, const char* sampler, const char* scheduler, int width, int height) {
     std::lock_guard<std::mutex> lock(g_request_defaults_mutex);
     g_request_defaults.steps     = steps;
diff --git a/examples/server/runtime.h b/examples/server/runtime.h
index 4658e6b..f4fbb7e 100644
--- a/examples/server/runtime.h
+++ b/examples/server/runtime.h
@@ -88,9 +88,22 @@ struct ServerADetailerPass {
 // PS5SD: stops the generation that runs (sd_cancel_generation), without waiting for a model that loads.
 void cancel_generation(ServerRuntime& rt);
 
+// "template" and "negative_template" of a request: the text the prompt was made from. With_preset puts them
+// into the parameters as "Template: <t>, Negative Template: <n>, " (A1111's Dynamic Prompts keys) before
+// "Preset:", and into the JSON as "ps5sd": {"template", "negative_template"}; a value with a comma, a colon,
+// a quote or a line break is written as a JSON string (A1111's quote()). "template" only when it is not empty;
+// "negative_template" whenever the body had it (an empty one as ""), so a reader can tell an empty negative
+// prompt from no template information.
+struct PromptTemplate {
+    std::string prompt;
+    std::string negative;
+    bool has_negative = false;  // "negative_template" was in the body, also when empty
+};
+
 struct ImgGenJobRequest {
     SDGenerationParams gen_params;
     bool temporary            = false;  // PS5SD: saved as tmp_<name>, not in the gallery's list
+    PromptTemplate prompt_template;     // PS5SD: "template" and "negative_template", kept in the saved parameters
     std::string output_format = "png";
     int output_compression    = 100;
     std::string preview_mode  = "none";
@@ -113,6 +126,7 @@ bool validate_server_img_gen_request(const ServerRuntime& runtime,
 struct VidGenJobRequest {
     SDGenerationParams gen_params;
     bool temporary            = false;  // PS5SD: as ImgGenJobRequest's
+    PromptTemplate prompt_template;     // PS5SD: as ImgGenJobRequest's
     std::string output_format = "webm";
     int output_compression    = 100;
     std::string preview_mode  = "none";
@@ -169,3 +183,9 @@ void apply_preset_extras(const ServerRuntime& runtime, SDGenerationParams& param
 std::string preset_name_now();
 // "temporary": true in a request body (img_gen, vid_gen).
 bool request_is_temporary(const json& body);
+
+// "template" and "negative_template" in a request body (img_gen, vid_gen): the text the prompt was made from
+// (the web UI's {a|b} and __name__), kept in the saved image's parameters. Strings of at most
+// k_max_template_bytes; false with the reason for another type or a longer text.
+constexpr size_t k_max_template_bytes = 8000;
+bool parse_prompt_template(const json& body, PromptTemplate& out, std::string& error_message);
