From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ps5sd <ps5sd@localhost>
Date: Sat, 24 Oct 2026 12:00:00 +0200
Subject: [PATCH] name conversion: FLUX.2's diffusers names

The diffusers names of FLUX.2 (Flux2Transformer2DModel) are mapped through
FLUX.1's table, which has no ff.linear_in/linear_out, ff_context.linear_in/
linear_out, nor the single blocks' attn.to_qkv_mlp_proj and attn.to_out. A
FLUX.2 Klein 9B LoRA in PEFT's diffusers names applied 128 of its 280 tensors
(the attention of the double blocks); with these six names it applies all.
---
diff --git a/src/name_conversion.cpp b/src/name_conversion.cpp
index 6a519ba..c5820c9 100644
--- a/src/name_conversion.cpp
+++ b/src/name_conversion.cpp
@@ -659,6 +659,12 @@ std::string convert_diffusers_dit_to_original_flux(std::string name) {
             flux_name_map[block_prefix + "ff_context.net.2.weight"]      = dst_prefix + "txt_mlp.2.weight";
             flux_name_map[block_prefix + "ff_context.net.2.bias"]        = dst_prefix + "txt_mlp.2.bias";
 
+            // FLUX.2 (diffusers' Flux2Transformer2DModel): the gated MLP, without biases
+            flux_name_map[block_prefix + "ff.linear_in.weight"]          = dst_prefix + "img_mlp.0.weight";
+            flux_name_map[block_prefix + "ff.linear_out.weight"]         = dst_prefix + "img_mlp.2.weight";
+            flux_name_map[block_prefix + "ff_context.linear_in.weight"]  = dst_prefix + "txt_mlp.0.weight";
+            flux_name_map[block_prefix + "ff_context.linear_out.weight"] = dst_prefix + "txt_mlp.2.weight";
+
             // output projections
             flux_name_map[block_prefix + "attn.to_out.0.weight"]   = dst_prefix + "img_attn.proj.weight";
             flux_name_map[block_prefix + "attn.to_out.0.bias"]     = dst_prefix + "img_attn.proj.bias";
@@ -690,6 +696,10 @@ std::string convert_diffusers_dit_to_original_flux(std::string name) {
             flux_name_map[dst_prefix + "norm.key_norm.weight"]   = dst_prefix + "norm.key_norm.scale";
             flux_name_map[block_prefix + "proj_out.weight"]      = dst_prefix + "linear2.weight";
             flux_name_map[block_prefix + "proj_out.bias"]        = dst_prefix + "linear2.bias";
+
+            // FLUX.2: qkv and the MLP in one projection, and its output
+            flux_name_map[block_prefix + "attn.to_qkv_mlp_proj.weight"] = dst_prefix + "linear1.weight";
+            flux_name_map[block_prefix + "attn.to_out.weight"]          = dst_prefix + "linear2.weight";
         }
 
         // --- final layers ---
