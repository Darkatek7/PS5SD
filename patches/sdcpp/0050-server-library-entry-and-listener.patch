@@ -149,7 +217,12 @@ int main(int argc, const char** argv) {
     register_sdcpp_api_endpoints(svr, runtime);
 
     LOG_INFO("listening on: http://%s:%d\n", svr_params.listen_ip.c_str(), svr_params.listen_port);
-    svr.listen(svr_params.listen_ip, svr_params.listen_port);
+    g_sd_server_svr = &svr;
+    const bool served = serve_until_terminated(svr, svr_params.listen_ip, svr_params.listen_port);
+    g_sd_server_svr = nullptr;
+    if (!served) {
+        LOG_ERROR("could not listen on %s:%d\n", svr_params.listen_ip.c_str(), svr_params.listen_port);
+    }
 
