-int main(int argc, const char** argv) {
+// PS5SD: errno that the PS5 network stack reports from accept() when the
+// interface went inactive (SCE_NET_EINACTIVEDISABLED: link down, new DHCP
+// lease, console resumed from rest mode). httplib takes any accept() failure
+// as fatal and closes the listening socket, so the listener is bound again.
+static constexpr int k_ps5_net_einactivedisabled = 163;
+
+// Set by sd_server_terminate(); reset when sd_server() returns so the entry
+// point can be called again.
+static std::atomic<bool> g_sd_server_stop{false};
+static std::atomic<httplib::Server*> g_sd_server_svr{nullptr};
+
+// Only SO_REUSEADDR. httplib's default picks SO_REUSEPORT where it exists,
+// which lets a second process bind the same port without an error.
+static void listener_socket_options(socket_t sock) {
+    int yes = 1;
+    setsockopt(sock, SOL_SOCKET, SO_REUSEADDR, reinterpret_cast<const char*>(&yes), sizeof(yes));
+}
+
+// Binds and serves until sd_server_terminate(). When the listener ends on its
+// own it is bound again, once a second, until that works or terminate is asked.
+// Returns false if the very first bind failed.
+static bool serve_until_terminated(httplib::Server& svr, const std::string& host, int port) {
+    if (!svr.bind_to_port(host, port)) {
+        return false;
+    }
+    while (!g_sd_server_stop) {
+        if (svr.listen_after_bind() || g_sd_server_stop) {
+            break;
+        }
+        if (errno == k_ps5_net_einactivedisabled) {
+            LOG_WARN("network went inactive (SCE_NET_EINACTIVEDISABLED); listening again\n");
+        } else {
+            LOG_ERROR("listener on %s:%d stopped unexpectedly (errno %d); listening again\n", host.c_str(), port, errno);
+        }
+        do {
+            std::this_thread::sleep_for(std::chrono::seconds(1));
+            svr.stop();  // clears the failed state; the socket is closed already
+        } while (!g_sd_server_stop && !svr.bind_to_port(host, port));
+        if (!g_sd_server_stop) {
+            LOG_INFO("listener on http://%s:%d is back\n", host.c_str(), port);
+        }
+    }
+    return true;
+}
+
+extern "C" void sd_server_terminate(void) {
+    g_sd_server_stop = true;
+    httplib::Server* svr = g_sd_server_svr.load();
+    if (svr != nullptr) {
+        svr->stop();
+    }
+}
+
+extern "C" int sd_server(int argc, char** argv_in) {
+    const char** argv = const_cast<const char**>(argv_in);
     if (argc > 1 && std::string(argv[1]) == "--version") {
