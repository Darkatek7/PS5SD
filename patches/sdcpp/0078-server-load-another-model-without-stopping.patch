+// Loads the model that ctx_params name into slot, after the one there is freed
+// (both take from the console's one memory pool). g_model_mutex is held alone.
+static bool load_model(ServerRuntime& rt,
+                       ModelSlot& slot,
+                       std::unique_ptr<SDContextParams> ctx_params,
+                       std::unique_ptr<SDGenerationParams> gen_params) {
+    {
+        std::lock_guard<std::mutex> lock(g_ctx_pointer_mutex);
+        rt.sd_ctx = nullptr;
+    }
+    slot.ctx.reset();
+    if (ctx_params == nullptr) {
+        return true;  // --standby: no model
+    }
+    LOG_DEBUG("%s", ctx_params->to_string().c_str());
+    LOG_DEBUG("%s", gen_params->to_string().c_str());
+    sd_ctx_params_t sd_ctx_params = ctx_params->to_sd_ctx_params_t(false);
+    SDCtxPtr ctx(new_sd_ctx(&sd_ctx_params));
+    if (ctx == nullptr) {
+        LOG_ERROR("new_sd_ctx_t failed");
+        return false;
+    }
+    slot.ctx_params      = std::move(ctx_params);
+    slot.gen_params      = std::move(gen_params);
+    slot.ctx             = std::move(ctx);
+    rt.ctx_params        = slot.ctx_params.get();
+    rt.default_gen_params = slot.gen_params.get();
+    {
+        std::lock_guard<std::mutex> lock(g_ctx_pointer_mutex);
+        rt.sd_ctx = slot.ctx.get();
+    }
+    // the next list reads the new model's folders again
+    if (rt.lora_cache != nullptr) {
+        std::lock_guard<std::mutex> lock(*rt.lora_mutex);
+        rt.lora_cache->clear();
+    }
+    if (rt.upscaler_cache != nullptr) {
+        std::lock_guard<std::mutex> lock(*rt.upscaler_mutex);
+        rt.upscaler_cache->clear();
+    }
+    return true;
