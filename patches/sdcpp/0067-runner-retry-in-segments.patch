From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ps5sd <ps5sd@localhost>
Date: Thu, 22 Oct 2026 16:00:00 +0200
Subject: [PATCH] runner: a whole graph that does not fit runs in segments

The plan runs a graph at once when it estimates that it fits next to the
weights. On the PS5 the allocation can then fail anyway (GPU memory that
earlier runs freed is not all usable again): FLUX.2 Klein 4B and FLUX.3
Klein at 1536x1536, SDXL at 2048x2048 after smaller images. Before
anything has run, such a graph now is built again and runs in its segments.
---
diff --git a/src/core/ggml_runner.cpp b/src/core/ggml_runner.cpp
index 4c156ed..e60d352 100644
--- a/src/core/ggml_runner.cpp
+++ b/src/core/ggml_runner.cpp
@@ -638,18 +638,36 @@ std::optional<sd::Tensor<float>> GGMLRunner::compute(get_graph_cb_t get_graph,
     if (!prepare_compute_graph(get_graph, &graph)) {
         return std::nullopt;
     }
-    params_tensor_set_dirty_ = true;
-    rebuild_params_tensor_set();
-    if (auto manager = residency_manager.lock()) {
-        for (int i = 0; i < sd::ggml_graph_cut::leaf_count(graph); ++i) {
-            auto* parameter = manager->resolve_param_tensor(sd::ggml_graph_cut::leaf_tensor(graph, i));
-            if (parameter != nullptr)
-                params_tensor_set_.insert(parameter);
+    auto collect_params = [&]() {
+        params_tensor_set_dirty_ = true;
+        rebuild_params_tensor_set();
+        if (auto manager = residency_manager.lock()) {
+            for (int i = 0; i < sd::ggml_graph_cut::leaf_count(graph); ++i) {
+                auto* parameter = manager->resolve_param_tensor(sd::ggml_graph_cut::leaf_tensor(graph, i));
+                if (parameter != nullptr)
+                    params_tensor_set_.insert(parameter);
+            }
         }
-    }
+    };
+    collect_params();
     std::optional<sd::Tensor<float>> output;
     try {
-        output = execute_graph(graph, n_threads, no_return, read_outputs);
+        bool retry_segmented = false;
+        output               = execute_graph(graph, n_threads, no_return, read_outputs, false, &retry_segmented);
+        // PS5SD: the plan runs the whole graph at once when it estimates that it fits next to the weights.
+        // When the allocation then does not fit after all (on the PS5, GPU memory that earlier runs freed is
+        // not all usable again), the graph is built again and runs in its segments. Only before anything ran.
+        if (!output.has_value() && retry_segmented) {
+            LOG_WARN("%s does not fit in one piece; retrying in segments", get_desc().c_str());
+            workspace_.release();
+            cut_cache_.clear();
+            if (!prepare_compute_graph(get_graph, &graph)) {
+                return std::nullopt;
+            }
+            collect_params();
+            last_compute_status_ = GGML_STATUS_FAILED;
+            output               = execute_graph(graph, n_threads, no_return, read_outputs, true, nullptr);
+        }
     } catch (const std::bad_alloc&) {
         last_compute_status_ = GGML_STATUS_ALLOC_FAILED;
         LOG_ERROR("%s graph allocation failed", get_desc().c_str());
@@ -826,7 +844,11 @@ bool GGMLRunner::execute_segment(ggml_cgraph* graph, int n_threads) {
     return true;
 }
 
-std::optional<Tensor<float>> GGMLRunner::execute_graph(ggml_cgraph* graph, int n_threads, bool no_return, const std::function<bool()>& read_outputs) {
+std::optional<Tensor<float>> GGMLRunner::execute_graph(ggml_cgraph* graph, int n_threads, bool no_return, const std::function<bool()>& read_outputs,
+                                                       bool force_segmented, bool* retry_segmented) {
+    if (retry_segmented != nullptr) {
+        *retry_segmented = false;
+    }
     if (!assign_graph_cut_layer_split_backends(graph)) {
         return std::nullopt;
     }
@@ -847,10 +869,10 @@ std::optional<Tensor<float>> GGMLRunner::execute_graph(ggml_cgraph* graph, int n
         return fits(requests, params);
     };
     auto manager         = residency_manager.lock();
-    const bool segmented = !is_multi_device() && !sd_backend_is_cpu(runtime_backend) &&
-                           manager != nullptr && manager->segmented_compute_enabled() &&
-                           cached_plan.valid && cached_plan.has_cuts && cached_plan.segments.size() > 1 &&
-                           !fits_monolithic();
+    const bool can_segment = !is_multi_device() && !sd_backend_is_cpu(runtime_backend) &&
+                             manager != nullptr && manager->segmented_compute_enabled() &&
+                             cached_plan.valid && cached_plan.has_cuts && cached_plan.segments.size() > 1;
+    const bool segmented   = can_segment && (force_segmented || !fits_monolithic());
     ggml_graph_cut::Plan monolithic_plan;
     if (!segmented) {
         monolithic_plan.segments.emplace_back();
@@ -899,6 +921,13 @@ std::optional<Tensor<float>> GGMLRunner::execute_graph(ggml_cgraph* graph, int n
                         index + 1, plan.segments.size(), segment.group_name.c_str(), phase);
             return std::nullopt;
         };
+        // PS5SD: nothing of the graph has run yet, so a whole graph can still go in segments (compute()).
+        auto fail_before_run = [&](const char* phase) {
+            if (retry_segmented != nullptr) {
+                *retry_segmented = !segmented && can_segment;
+            }
+            return fail_segment(phase);
+        };
         cut_cache_.prune(segment.live_cut_names);
         bindings.reset(segment);
         if (!bindings.bind_cached_inputs(segment, get_desc().c_str())) {
@@ -927,7 +956,7 @@ std::optional<Tensor<float>> GGMLRunner::execute_graph(ggml_cgraph* graph, int n
         auto measurement = segmented ? measure(segment_graph, segment.compute_buffer_size) : full_measurement;
         if (!workspace_.prepare(measurement)) {
             last_compute_status_ = GGML_STATUS_ALLOC_FAILED;
-            return fail_segment("workspace preparation");
+            return fail_before_run("workspace preparation");
         }
         const size_t cut_bytes       = last ? 0 : cut_cache_.estimate_output_bytes(graph, segment);
         const size_t new_cache_bytes = add_bytes(cut_bytes, cache_.pending_bytes(segment_graph));
@@ -948,7 +977,7 @@ std::optional<Tensor<float>> GGMLRunner::execute_graph(ggml_cgraph* graph, int n
             return ready;
         };
         if (!weights.segment_start(index, ensure_capacity)) {
-            return fail_segment("weight preparation");
+            return fail_before_run("weight preparation");
         }
         // Preparing weights can execute LoRA graphs and reclaim an idle workspace.
         if (!workspace_.measurement_matches(segment_graph, measurement)) {
@@ -956,16 +985,16 @@ std::optional<Tensor<float>> GGMLRunner::execute_graph(ggml_cgraph* graph, int n
         }
         if (!workspace_.prepare(measurement)) {
             last_compute_status_ = GGML_STATUS_ALLOC_FAILED;
-            return fail_segment("workspace preparation");
+            return fail_before_run("workspace preparation");
         }
         if (!ensure_capacity()) {
-            return fail_segment("workspace capacity check");
+            return fail_before_run("workspace capacity check");
         }
         if (!workspace_.allocate(segment_graph, [&](ggml_backend_sched_t scheduler, ggml_cgraph* current) {
                 pin_multi_device_nodes(scheduler, current);
             })) {
             last_compute_status_ = GGML_STATUS_ALLOC_FAILED;
-            return fail_segment("workspace allocation");
+            return fail_before_run("workspace allocation");
         }
         for (const auto& size : measurement.buffers) {
             track_compute_buffer(size.backend);
@@ -974,7 +1003,7 @@ std::optional<Tensor<float>> GGMLRunner::execute_graph(ggml_cgraph* graph, int n
             track_compute_buffer(workspace_.cpu_backend());
         }
         if (!ensure_capacity()) {
-            return fail_segment("allocated capacity check");
+            return fail_before_run("allocated capacity check");
         }
         copy_data_to_backend_tensor(segment_graph, false);
         auto prefetch_requests = memory_requests(measurement.buffers, new_cache_bytes);
diff --git a/src/core/ggml_runner.h b/src/core/ggml_runner.h
index 02630c0..b49cb3e 100644
--- a/src/core/ggml_runner.h
+++ b/src/core/ggml_runner.h
@@ -147,7 +147,8 @@ private:
     bool fits(const std::vector<DeviceMemoryRequest>& requests,
               const std::vector<ggml_tensor*>& params) const;
     bool execute_segment(ggml_cgraph* graph, int n_threads);
-    std::optional<sd::Tensor<float>> execute_graph(ggml_cgraph* graph, int n_threads, bool no_return, const std::function<bool()>& read_outputs);
+    std::optional<sd::Tensor<float>> execute_graph(ggml_cgraph* graph, int n_threads, bool no_return, const std::function<bool()>& read_outputs,
+                                                   bool force_segmented = false, bool* retry_segmented = nullptr);
 
 protected:
     typedef std::function<ggml_cgraph*()> get_graph_cb_t;
