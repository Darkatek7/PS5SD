-std::vector<std::string> save_output_images(const SDSvrParams& svr_params, SDImageVec& images) {
+// ---- thumbnails: <output-dir>/.thumbs/<name>.jpg; the listing skips the folder (no gallery type)
+
+static const int kThumbSide = 320;
+
+static fs::path thumbs_dir(const fs::path& dir) {
+    return dir / ".thumbs";
+}
+
+// Writes the bytes to path through a .tmp file, so a reader never sees half of them.
+static bool write_whole(const fs::path& path, const void* data, size_t size) {
+    const fs::path tmp = fs::u8path(path.u8string() + ".tmp");
+    {
+        std::ofstream file(tmp, std::ios::binary);
+        file.write(static_cast<const char*>(data), static_cast<std::streamsize>(size));
+        file.close();
+        if (!file) {
+            return false;
+        }
+    }
+    std::error_code ec;
+    fs::rename(tmp, path, ec);
+    return !ec;
+}
+
+// The image at most kThumbSide px a side (each pixel the mean of the ones it covers), as a JPEG.
+static bool write_thumbnail(const fs::path& dir, const std::string& name, const uint8_t* data, int w, int h, int c) {
+    if (data == nullptr || w <= 0 || h <= 0 || c <= 0) {
+        return false;
+    }
+    const double k = std::max(w, h) > kThumbSide ? (double)kThumbSide / std::max(w, h) : 1.0;
+    const int tw   = std::max(1, (int)std::lround(w * k));
+    const int th   = std::max(1, (int)std::lround(h * k));
+    std::vector<uint8_t> small((size_t)tw * th * 3);
+    for (int y = 0; y < th; ++y) {
+        const int y0 = (int)((int64_t)y * h / th);
+        const int y1 = std::max(y0 + 1, (int)((int64_t)(y + 1) * h / th));
+        for (int x = 0; x < tw; ++x) {
+            const int x0    = (int)((int64_t)x * w / tw);
+            const int x1    = std::max(x0 + 1, (int)((int64_t)(x + 1) * w / tw));
+            uint32_t sum[3] = {0, 0, 0};
+            for (int yy = y0; yy < y1; ++yy) {
+                const uint8_t* p = data + ((size_t)yy * w + x0) * c;
+                for (int xx = x0; xx < x1; ++xx, p += c) {
+                    for (int ch = 0; ch < 3; ++ch) {
+                        sum[ch] += p[c >= 3 ? ch : 0];
+                    }
+                }
+            }
+            const uint32_t n = (uint32_t)((y1 - y0) * (x1 - x0));
+            uint8_t* o       = &small[((size_t)y * tw + x) * 3];
+            for (int ch = 0; ch < 3; ++ch) {
+                o[ch] = (uint8_t)((sum[ch] + n / 2) / n);
+            }
+        }
+    }
+    const std::vector<uint8_t> jpeg = encode_image_to_vector(EncodedImageFormat::JPEG, small.data(), tw, th, 3, "", 80);
+    std::error_code ec;
+    fs::create_directories(thumbs_dir(dir), ec);
+    return !jpeg.empty() && write_whole(thumbs_dir(dir) / (name + ".jpg"), jpeg.data(), jpeg.size());
+}
