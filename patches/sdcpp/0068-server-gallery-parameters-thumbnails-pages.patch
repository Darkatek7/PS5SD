+// The text of a PNG's tEXt "parameters" chunk ("" when it has none). Reads the
+// chunk headers and skips the data, so a large PNG costs a few reads.
+std::string png_parameters(const fs::path& path) {
+    std::ifstream file(path, std::ios::binary);
+    char sig[8];
+    if (!file.read(sig, 8) || std::memcmp(sig, "\x89PNG\r\n\x1a\n", 8) != 0) {
+        return "";
+    }
+    unsigned char head[8];
+    while (file.read(reinterpret_cast<char*>(head), 8)) {
+        const uint32_t len = (uint32_t)head[0] << 24 | (uint32_t)head[1] << 16 | (uint32_t)head[2] << 8 | head[3];
+        const std::string type(reinterpret_cast<char*>(head) + 4, 4);
+        if (type == "IEND" || len > (256u << 20)) {
+            break;
+        }
+        if (type == "tEXt" && len > 11 && len < (1u << 20)) {
+            std::string data(len, '\0');
+            if (!file.read(&data[0], len)) {
+                break;
+            }
+            if (data.compare(0, 11, std::string("parameters\0", 11)) == 0) {
+                return data.substr(11);
+            }
+            file.seekg(4, std::ios::cur);
+        } else {
+            file.seekg((std::streamoff)len + 4, std::ios::cur);
+        }
+    }
+    return "";
+}
+
+// What made a file of the gallery: a PNG's own text, else the text saved next to it.
+std::string file_parameters(const fs::path& dir, const std::string& name, const char* type) {
+    if (type != nullptr && std::strcmp(type, "image/png") == 0) {
+        return png_parameters(dir / name);
+    }
+    std::ifstream file(thumbs_dir(dir) / (name + ".txt"), std::ios::binary);
+    return std::string((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+}
+
+// The parameters of each file, kept while its size and time stay the same: a
+// listing reads only the files it has not seen.
+struct ParamCache {
+    struct Item {
+        uintmax_t size  = 0;
+        int64_t created = 0;
+        std::string parameters;
+    };
+    std::mutex mutex;
+    std::map<std::string, Item> items;
 };
 
+ParamCache& param_cache() {
+    static ParamCache cache;
+    return cache;
+}
+
+// The prompt of A1111's text: the lines before "Negative prompt:" and before the last line, which
+// holds the settings ("Steps: ..."). The whole text when it has no such line.
+std::string prompt_of(const std::string& parameters) {
+    size_t end = parameters.rfind("\nSteps: ");
+    if (end == std::string::npos) {
+        return parameters;
+    }
+    const size_t neg = parameters.find("\nNegative prompt: ");
+    if (neg != std::string::npos && neg < end) {
+        end = neg;
+    }
+    return parameters.substr(0, end);
+}
+
+// sd.cpp's JSON at the end of the text (", SDCPP: {...}"); null when there is none.
+json sdcpp_of(const std::string& parameters) {
+    const size_t at = parameters.rfind(", SDCPP: {");
+    if (at == std::string::npos) {
+        return nullptr;
+    }
+    json j = json::parse(parameters.substr(at + 9), nullptr, false);
+    return j.is_discarded() ? json(nullptr) : j;
+}
+
+std::string lower_ascii(std::string s) {
+    std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    return s;
+}
+
