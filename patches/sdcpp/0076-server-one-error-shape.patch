diff --git a/examples/server/api_error.cpp b/examples/server/api_error.cpp
new file mode 100644
index 0000000..f0520b4
--- /dev/null
+++ b/examples/server/api_error.cpp
@@ -0,0 +1,155 @@
+#include "api_error.h"
+
+#include <exception>
+#include <string>
+
+#include "httplib.h"
+
+using json = nlohmann::json;
+
+namespace {
+
+std::string dump(const json& j) {
+    // a message may quote a file name that is not UTF-8
+    return j.dump(-1, ' ', false, json::error_handler_t::replace);
+}
+
+bool starts_with(const std::string& s, const char* prefix) {
+    return s.rfind(prefix, 0) == 0;
+}
+
+std::string trimmed(const std::string& s) {
+    const size_t a = s.find_first_not_of(" \t\r\n");
+    if (a == std::string::npos) {
+        return {};
+    }
+    const size_t b = s.find_last_not_of(" \t\r\n");
+    return s.substr(a, b - a + 1);
+}
+
+}  // namespace
+
+std::string api_error_code_for_status(int status) {
+    switch (status) {
+        case 400: return "invalid_request";
+        case 401: return "unauthorized";
+        case 403: return "forbidden";
+        case 404: return "not_found";
+        case 405: return "method_not_allowed";
+        case 409: return "conflict";
+        case 410: return "expired";
+        case 413: return "payload_too_large";
+        case 422: return "unprocessable";
+        case 429: return "rate_limited";
+        case 500: return "server_error";
+        case 501: return "not_implemented";
+        case 502: return "bad_gateway";
+        case 503: return "unavailable";
+        case 504: return "timeout";
+        case 507: return "storage_full";
+        default: return "http_" + std::to_string(status);
+    }
+}
+
+json api_error(const std::string& code, const std::string& message) {
+    return {{"error", {{"code", code}, {"message", message}}}};
+}
+
+void send_api_error(httplib::Response& res, int status, const std::string& code, const std::string& message) {
+    res.status = status;
+    res.set_content(dump(api_error(code, message)), "application/json");
+}
+
+void send_exception_error(httplib::Response& res, const std::exception& e) {
+    if (dynamic_cast<const json::exception*>(&e) != nullptr) {
+        send_api_error(res, 400, "invalid_request", std::string("invalid JSON: ") + e.what());
+    } else {
+        send_api_error(res, 500, "server_error", e.what());
+    }
+}
+
+bool api_error_normalize(int status, const std::string& content_type, const std::string& fallback, std::string& body) {
+    json j;
+    if (starts_with(content_type, "application/json")) {
+        j = json::parse(body, nullptr, false);
+    }
+    if (!j.is_object()) {
+        // empty, plain text, or not JSON: its text, if short, is the message
+        std::string message = trimmed(body);
+        if (message.empty() || message.size() > 1000 || !starts_with(content_type, "text/plain")) {
+            message = fallback;
+        }
+        body = dump(api_error(api_error_code_for_status(status), message));
+        return true;
+    }
+
+    auto it = j.find("error");
+    if (it != j.end() && it->is_object()) {
+        bool changed = false;
+        if (!it->contains("code") || !(*it)["code"].is_string()) {
+            (*it)["code"] = api_error_code_for_status(status);
+            changed       = true;
+        }
+        if (!it->contains("message") || !(*it)["message"].is_string()) {
+            (*it)["message"] = fallback;
+            changed          = true;
+        }
+        if (changed) {
+            body = dump(j);
+        }
+        return changed;
+    }
+
+    std::string code = api_error_code_for_status(status);
+    if (j.contains("code") && j["code"].is_string()) {
+        code = j["code"].get<std::string>();
+    } else if (j.contains("standby") && j["standby"].is_boolean() && j["standby"].get<bool>()) {
+        code = "standby";
+    }
+    std::string message = it != j.end() && it->is_string() ? it->get<std::string>() : std::string();
+    if (j.contains("message") && j["message"].is_string()) {
+        const std::string more = j["message"].get<std::string>();
+        message                = message.empty() ? more : message + ": " + more;
+    }
+    if (message.empty()) {
+        message = fallback;
+    }
+    j.erase("code");
+    j.erase("message");
+    j.erase("standby");
+    j.erase("auth_required");
+    j["error"] = {{"code", code}, {"message", message}};
+    body       = dump(j);
+    return true;
+}
+
+void install_error_shape(httplib::Server& svr) {
+    svr.set_error_handler([](const httplib::Request& req, httplib::Response& res) {
+        if (res.content_provider_) {
+            return httplib::Server::HandlerResponse::Unhandled;  // a stream: nothing to rewrite
+        }
+        std::string fallback = httplib::status_message(res.status);
+        if (res.status == 404 && res.body.empty()) {
+            fallback = "no route " + req.method + " " + req.path;
+        }
+        const std::string type = res.get_header_value("Content-Type");
+        if (!api_error_normalize(res.status, type, fallback, res.body)) {
+            return httplib::Server::HandlerResponse::Unhandled;
+        }
+        res.headers.erase("Content-Type");
+        res.set_header("Content-Type", "application/json");
+        return httplib::Server::HandlerResponse::Handled;
+    });
+    svr.set_exception_handler([](const httplib::Request&, httplib::Response& res, std::exception_ptr ep) {
+        std::string what = "unknown exception";
+        try {
+            if (ep) {
+                std::rethrow_exception(ep);
+            }
+        } catch (const std::exception& e) {
+            what = e.what();
+        } catch (...) {
+        }
+        send_api_error(res, 500, "server_error", what);
+    });
+}
diff --git a/examples/server/api_error.h b/examples/server/api_error.h
new file mode 100644
index 0000000..3125b42
--- /dev/null
+++ b/examples/server/api_error.h
@@ -0,0 +1,55 @@
+// PS5SD: one shape for every error answer, on every route:
+//
+//   {"error": {"code": "<code>", "message": "<what happened, for people>"}}
+//
+// as a failed job has it in its "error" and as the OpenAI API answers. code is
+// a short word a program can test (out_of_memory, queue_full, standby, ...);
+// without a better one it is the status's (api_error_code_for_status).
+//
+// install_error_shape() puts every answer of 400 and more into that shape on
+// its way out (cpp-httplib's error handler), so the routes that answer
+// {"error": "text"}, an empty body or plain text (a route that does not exist)
+// come out the same:
+//   - a text "error" becomes the message; a "message" next to it is added
+//     after a colon (sd-server's {"error": "invalid json", "message": ...});
+//   - a top-level "code" names the code; "standby": true is the code standby;
+//     both flags, and "auth_required", are taken out;
+//   - every other top-level field stays.
+// An "error" that is an object already keeps its code and message; a missing
+// one is filled in.
+#pragma once
+
+#include <exception>
+#include <string>
+
+#include <json.hpp>
+
+namespace httplib {
+class Server;
+struct Response;
+}  // namespace httplib
+
+// The code of a status: 400 invalid_request, 401 unauthorized, 403 forbidden,
+// 404 not_found, 405 method_not_allowed, 409 conflict, 410 expired,
+// 413 payload_too_large, 422 unprocessable, 429 rate_limited, 500 server_error,
+// 501 not_implemented, 502 bad_gateway, 503 unavailable, 504 timeout,
+// 507 storage_full; any other is "http_<status>".
+std::string api_error_code_for_status(int status);
+
+nlohmann::json api_error(const std::string& code, const std::string& message);
+
+// Sets the status and the body {"error": {"code", "message"}}.
+void send_api_error(httplib::Response& res, int status, const std::string& code, const std::string& message);
+
+// Puts body into the shape above. content_type is the answer's; fallback is the
+// message when the body has none. True when body changed.
+bool api_error_normalize(int status, const std::string& content_type, const std::string& fallback, std::string& body);
+
+// A route's catch: a JSON error (a body that is not JSON, a field of the wrong
+// type) is 400 invalid_request, anything else 500 server_error; the message is
+// what was thrown.
+void send_exception_error(httplib::Response& res, const std::exception& e);
+
+// The error handler that normalizes every answer of 400 and more, and an
+// exception handler that answers 500 server_error with what was thrown.
+void install_error_shape(httplib::Server& svr);
