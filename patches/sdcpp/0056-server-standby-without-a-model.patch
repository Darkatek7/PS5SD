+static void print_usage(const char* argv0, const std::vector<ArgOptions>& options_list) {
+    std::cout << version_string() << "\n";
+    std::cout << "Usage: " << argv0 << " [options]\n\n";
+    std::cout << "Svr Options:\n";
+    options_list[0].print();
