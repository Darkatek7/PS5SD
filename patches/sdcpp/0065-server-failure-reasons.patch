 #include "common/common.h"
 #include "server_hooks.h"
 
+// PS5SD: why a generation failed. sd_log_cb feeds the WARN and ERROR lines of
+// the log in as they come; ActivityJob::begin() forgets the older ones.
+// sd_server_failure_reason() reads them back when a job has failed.
+void sd_server_failure_log_begin();
+void sd_server_failure_log_add(sd_log_level_t level, const char* text);
+// A client stopped the generation that runs now (sd_cancel_generation); the
+// reason is then "Cancelled", not the error the stop caused.
+void sd_server_failure_log_cancelled();
+// The reason for a failed job, as a person should read it: "Cancelled" after a
+// stop, a memory message
+// when the log says the console ran out of memory, else the last ERROR line,
+// else fallback.
+std::string sd_server_failure_reason(const std::string& fallback);
+
 // One generation as seen by the activity hooks: begin() when the generation
 // starts, finish() when it is over. If finish() is never reached (an early
 // return, an exception) the destructor reports the job as failed.
@@ -27,6 +41,7 @@ public:
     void begin() {
         if (!begun_) {
             begun_ = true;
+            sd_server_failure_log_begin();
             sd_activity_job_begin(kind_, prompt_.c_str(), width_, height_, steps_);
         }
     }
@@ -34,7 +49,12 @@ public:
     void finish(bool ok, const std::string& output_path) {
         if (begun_ && !finished_) {
             finished_ = true;
-            sd_activity_job_end(ok ? 1 : 0, output_path.c_str());
+            if (ok) {
+                sd_activity_job_end(1, output_path.c_str());
+            } else {
+                const std::string reason = sd_server_failure_reason("");
+                sd_activity_job_end(0, reason.c_str());
+            }
         }
     }
 
diff --git a/examples/server/server_hooks.cpp b/examples/server/server_hooks.cpp
index 816af9b..6d42a04 100644
--- a/examples/server/server_hooks.cpp
+++ b/examples/server/server_hooks.cpp
@@ -6,6 +6,14 @@
 
 #include "server_hooks.h"
 
+#include <algorithm>
+#include <cctype>
+#include <deque>
+#include <mutex>
+#include <string>
+
+#include "server_activity.h"
+
 #if defined(__GNUC__) || defined(__clang__)
 #define SD_SERVER_WEAK __attribute__((weak))
 #else
@@ -26,3 +34,101 @@ SD_SERVER_WEAK int sd_app_upload(const char*, uint64_t, sd_app_reader, void*, ch
 }
 
 }
+
+// PS5SD: the reason a generation failed. The WARN and ERROR lines of the log
+// are kept while a job runs, so a failed job can say why, not only that it
+// failed. Only the last few lines are kept.
+
+namespace {
+
+constexpr size_t k_failure_lines_kept = 16;
+
+struct FailureLine {
+    sd_log_level_t level;
+    std::string text;
+};
+
+std::mutex g_failure_mutex;
+std::deque<FailureLine> g_failure_lines;
+bool g_failure_cancelled = false;
+
+// Case-insensitive substring test.
+bool contains_ci(const std::string& text, const char* needle) {
+    const std::string n(needle);
+    const auto same = [](char a, char b) {
+        return std::tolower(static_cast<unsigned char>(a)) == std::tolower(static_cast<unsigned char>(b));
+    };
+    return std::search(text.begin(), text.end(), n.begin(), n.end(), same) != text.end();
+}
+
+// The log line without its line break and without the " --- <file>:<line>" tail
+// that sd.cpp adds to its lines.
+std::string failure_line_text(const char* log) {
+    std::string text = log ? log : "";
+    while (!text.empty() && (text.back() == '\n' || text.back() == '\r')) {
+        text.pop_back();
+    }
+    const std::string sep = " --- ";
+    const size_t at       = text.rfind(sep);
+    if (at != std::string::npos && text.find_first_of(" \t", at + sep.size()) == std::string::npos) {
+        text.erase(at);
+    }
+    return text;
+}
+
+}  // namespace
+
+void sd_server_failure_log_begin() {
+    std::lock_guard<std::mutex> lock(g_failure_mutex);
+    g_failure_lines.clear();
+    g_failure_cancelled = false;
+}
+
+void sd_server_failure_log_cancelled() {
+    std::lock_guard<std::mutex> lock(g_failure_mutex);
+    g_failure_cancelled = true;
+}
+
+void sd_server_failure_log_add(sd_log_level_t level, const char* text) {
+    if (level != SD_LOG_WARN && level != SD_LOG_ERROR) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(g_failure_mutex);
+    g_failure_lines.push_back({level, failure_line_text(text)});
+    while (g_failure_lines.size() > k_failure_lines_kept) {
+        g_failure_lines.pop_front();
+    }
+}
+
+std::string sd_server_failure_reason(const std::string& fallback) {
+    static const char* const k_memory_markers[] = {
+        "cannot make enough memory available",
+        "out of memory",
+        "outofdevicememory",
+        "outofhostmemory",
+        "failed to allocate",
+    };
+    std::lock_guard<std::mutex> lock(g_failure_mutex);
+    if (g_failure_cancelled) {
+        return "Cancelled";
+    }
+    for (const FailureLine& line : g_failure_lines) {
+        for (const char* marker : k_memory_markers) {
+            if (contains_ci(line.text, marker)) {
+                return "Not enough memory on the console for this run. Try a smaller size, fewer images or frames, "
+                       "a lower hires scale, or a smaller model.";
+            }
+        }
+    }
+    for (auto it = g_failure_lines.rbegin(); it != g_failure_lines.rend(); ++it) {
+        if (it->level == SD_LOG_ERROR) {
+            std::string text         = it->text;
+            const std::string prefix = "ggml: ";
+            if (text.compare(0, prefix.size(), prefix) == 0) {
+                text.erase(0, prefix.size());
+            }
+            return "Generation failed: " + text;
+        }
+    }
+    return fallback;
+}
