@@ -684,6 +685,25 @@ void register_sdcpp_api_endpoints(httplib::Server& svr, ServerRuntime& rt) {
             }
 
             json body = json::parse(req.body);
+
+            // PS5SD: "repeat" runs the request N times, one generation after the other.
+            int repeat = 1;
+            if (body.contains("repeat")) {
+                const bool valid = body["repeat"].is_number_integer() &&
+                                   body["repeat"].get<int64_t>() >= 1 &&
+                                   body["repeat"].get<int64_t>() <= k_max_img_gen_repeat;
+                if (!valid) {
+                    res.status = 400;
+                    res.set_content(json({{"error", "repeat must be a whole number from 1 to 100000"}}).dump(),
+                                    "application/json");
+                    return;
+                }
+                repeat = static_cast<int>(body["repeat"].get<int64_t>());
+            }
+            // No seed, or a negative one: every repetition draws its own seed.
+            const bool random_seed = !(body.contains("seed") && body["seed"].is_number_integer() &&
+                                       body["seed"].get<int64_t>() >= 0);
+
             ImgGenJobRequest request;
             std::string error_message;
             if (!parse_img_gen_request(body, *runtime, request, error_message)) {
@@ -698,6 +718,8 @@ void register_sdcpp_api_endpoints(httplib::Server& svr, ServerRuntime& rt) {
             job->status                             = AsyncJobStatus::Queued;
             job->created_at                         = unix_timestamp_now();
             job->img_gen                            = std::move(request);
+            job->repeat_total                       = repeat;
+            job->repeat_random_seed                 = random_seed;
 
             {
                 std::lock_guard<std::mutex> lock(manager.mutex);
