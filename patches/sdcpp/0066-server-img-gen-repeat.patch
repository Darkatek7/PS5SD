         } else if (job->kind == AsyncJobKind::VidGen) {
             ok = execute_vid_gen_job(runtime,
                                      *job,
diff --git a/examples/server/async_jobs.h b/examples/server/async_jobs.h
index b10959c..f996402 100644
--- a/examples/server/async_jobs.h
+++ b/examples/server/async_jobs.h
@@ -51,8 +51,17 @@ struct AsyncGenerationJob {
     int preview_total_steps   = 0;
     // PS5SD: set when a client cancels the job while it generates.
     bool cancel_requested = false;
+    // PS5SD: img_gen "repeat". The worker updates done and saved under the
+    // manager mutex; total and random_seed are set before the job is queued.
+    int repeat_total        = 1;
+    int repeat_done         = 0;
+    bool repeat_random_seed = false;  // the request named no seed >= 0
+    std::vector<std::string> repeat_saved;  // gallery file names, the last 50
 };
 
+// PS5SD: the most repetitions one img_gen job may run.
+constexpr int k_max_img_gen_repeat = 100000;
+
 struct AsyncJobManager {
     std::mutex mutex;
     std::condition_variable cv;
@@ -72,6 +81,7 @@ std::string make_async_job_id(AsyncJobManager& manager);
 bool cancel_queued_job(AsyncJobManager& manager, AsyncGenerationJob& job);
 json make_async_job_json(const AsyncJobManager& manager, const AsyncGenerationJob& job);
 bool execute_img_gen_job(ServerRuntime& runtime,
+                         AsyncJobManager& manager,
                          AsyncGenerationJob& job,
                          std::vector<std::string>& output_images,
                          std::string& error_message);
